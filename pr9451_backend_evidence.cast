[0.000, "o", "+    original_state = {\r\n"]
[0.000, "o", "+        \"player_character_data\": {\r\n"]
[0.000, "o", "+            \"level\": 3,\r\n+            \"experience\": {\"current\": 2690, \"to_next_level\": 3810},\r\n+        }\r\n+    }\r\n+    structured_fields = {\r\n+        \"planning_block\": {\r\n+            \"choices\": [\r\n+                {\"id\": \"continue_training\", \"text\": \"Continue Training\"}\r\n+            ]\r\n+        },\r\n+        \"state_updates\": {\"player_character_data\": copy.deepcopy(authored_sheet)},\r\n+    }\r\n+    raw_model_fields = copy.deepcopy(structured_fields)\r\n+    expected_updates = {\"player_character_data\": copy.deepcopy(authored_sheet)}\r\n+    game_state.canonicalize_state_updates_in_place(expected_updates)\r\n+    expected_sheet = expected_updates[\"player_character_data\"]\r\n+\r\n+    _rewards_box, planning_block = rewards_engine.canonicalize_rewards(\r\n+        structured_fields,\r\n+        state,\r\n+        original_state,\r\n+    )\r\n+\r\n+    assert \"level_up_signal\" not in raw_model_fields\r\n+    assert \"rewards_box\" not in raw_model_fields\r\n+    assert state[\"player_character_data\"][\"level\"] == 4\r\n+    persisted_sheet = cop"]
[0.000, "o", "y.deepcopy(state[\"player_character_data\"])\r\n"]
[0.000, "o", "+    persisted_sheet.pop(\"xp\", None)\r\n+    persisted_sheet.pop(\"xp_current\", None)\r\n+    assert persisted_sheet == expected_sheet\r\n+    session = state[\"level_up_session\"]\r\n+    assert session[\"status\"] == STATUS_IN_PROGRESS\r\n+    assert session[\"from_level\"] == 3\r\n+    assert session[\"to_level\"] == 4\r\n+    assert session[\"applied\"] == expected_sheet\r\n+    expected_choice_ids = {\"continue_training\", \"level_up_review\"}\r\n+    assert {choice[\"id\"] for choice in planning_block[\"choices\"]} == expected_choice_ids\r\n+    assert {\r\n+        choice[\"id\"] for choice in structured_fields[\"planning_block\"][\"choices\"]\r\n+    } == expected_choice_ids\r\n+    assert {\r\n+        choice[\"id\"] for choice in state[\"planning_block\"][\"choices\"]\r\n+    } == expected_choice_ids\r\n"]
[0.000, "o", "+\r\n+\r\n+def test_legacy_progression_fields_are_inert_but_tangible_rewards_survive():\r\n"]
[0.000, "o", "+    \"\"\"Only PCD may authorize progression; legacy model fields are ignored.\"\"\"\r\n+    original_state = {\r\n"]
[0.000, "o", "+        \"player_character_data\": {\r\n"]
[0.000, "o", "+            \"level\": 3,\r\n"]
[0.000, "o", "+            \"experience\": {\"current\": 2690, \"to_next_level\": 3810},\r\n"]
[0.000, "o", "+        }\r\n"]
[0.000, "o", "+    }\r\n"]
[0.000, "o", "+    state = copy.deepcopy(original_state)\r\n+    structured_fields = {\r\n+        \"level_up_signal\": {\r\n+            \"current_level\": 3,\r\n+            \"target_level\": 99,\r\n+            \"level_up\": True,\r\n+            \"previous_turn_exp\": 2690,\r\n+            \"current_turn_exp\": 999999,\r\n+            \"xp_total\": 999999,\r\n+        },\r\n+        \"rewards_box\": {\r\n+            \"source\": \"treasure\",\r\n+            \"loot\": [\"sword\"],\r\n+            \"gold\": 25,\r\n+            \"xp_gained\": 999999,\r\n+            \"current_xp\": 999999,\r\n+            \"new_level\": 99,\r\n+            \"level_up_available\": True,\r\n+        },\r\n+        \"planning_block\": {\r\n+            \"choices\": [{\"id\": \"continue_adventuring\", \"text\": \"Continue\"}]\r\n+        },\r\n+    }\r\n"]
[0.000, "o", "+\r\n"]
[0.000, "o", "+    structured_fields_utils.strip_model_progression_fields(structured_fields)\r\n+    rewards_box, planning_block = rewards_engine.canonicalize_rewards(\r\n+        structured_fields, state, original_state\r\n+    )\r\n+\r\n+    assert state[\"player_character_data\"][\"level\"] == 3\r\n+    assert state[\"player_character_data\"][\"experience\"] == {\r\n+        \"current\": 2690,\r\n+        \"to_next_level\": 3810,\r\n+    }\r\n+    assert \"level_up_session\" not in state\r\n+    assert rewards_box is not None\r\n+    assert rewards_box[\"loot\"] == [\"sword\"]\r\n+    assert rewards_box[\"gold\"] == 25\r\n+    assert rewards_box.get(\"current_xp\") == 2690\r\n+    for key in (\"xp_gained\", \"new_level\", \"level_up_available\"):\r\n+        assert key not in rewards_box\r\n"]
[0.000, "o", "+    assert planning_block is not None\r\n+    assert {choice[\"id\"] for choice in planning_block[\"choices\"]} == {\r\n+        \"continue_adventuring\"\r\n"]
[0.000, "o", "+    }\r\n"]
