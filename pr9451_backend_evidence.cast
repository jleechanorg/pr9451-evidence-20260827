[0.000, "o", "-                    \"minute\": 20,\r\n-                    \"second\": 0,\r\n-                    \"microsecond\": 3,\r\n"]
[0.000, "o", "-                },\r\n"]
[0.000, "o", "-            }\r\n"]
[0.000, "o", "-        self._game_state_ref(db, campaign_id).set(state)\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-    # -------------------------------------------------------------------------\r\n-    # Test 1.1 - B2/F1\r\n"]
[0.000, "o", "-    # -------------------------------------------------------------------------\r\n"]
[0.000, "o", "-    @patch(\"mvp_site.firestore_service.get_db\")\r\n"]
