[0.000, "o", "+@dataclass(frozen=True)\r\n"]
[0.000, "o", "+class GoldenLLMRequestExpectation:\r\n"]
[0.000, "o", "+    \"\"\"Validate a real backend-built LLMRequest against a BQ golden contract.\"\"\"\r\n"]
[0.000, "o", "+\r\n"]
[0.000, "o", "+    source: dict[str, Any]\r\n"]
[0.000, "o", "+    required_top_level_keys: tuple[str, ...]\r\n"]
[0.000, "o", "+    required_path_types: dict[str, str]\r\n+    forbidden_paths: tuple[str, ...]\r\n"]
[0.000, "o", "+\r\n"]
[0.000, "o", "+    @classmethod\r\n"]
[0.000, "o", "+    def from_file(cls, path: str | Path) -> GoldenLLMRequestExpectation:\r\n"]
[0.000, "o", "+        payload = json.loads(Path(path).read_text(encoding=\"utf-8\"))\r\n+        return cls(\r\n"]
[0.000, "o", "+            source=payload[\"source\"],\r\n"]
[0.000, "o", "+            required_top_level_keys=tuple(payload[\"required_top_level_keys\"]),\r\n"]
[0.000, "o", "+            required_path_types=dict(payload[\"required_path_types\"]),\r\n"]
[0.000, "o", "+            forbidden_paths=tuple(payload[\"forbidden_paths\"]),\r\n"]
[0.000, "o", "+        )\r\n"]
[0.000, "o", "+\r\n"]
[0.000, "o", "+    def assert_matches(self, actual_request: dict[str, Any], *, phase: str) -> None:\r\n"]
[0.000, "o", "+        missing = [\r\n"]
[0.000, "o", "+            key for key in self.required_top_level_keys if key not in actual_request\r\n"]
[0.000, "o", "+        ]\r\n"]
[0.000, "o", "+        if missing:\r\n"]
[0.000, "o", "+            raise AssertionError(f\"{phase}: golden request keys missing: {missing}\")\r\n"]
[0.000, "o", "+\r\n"]
[0.000, "o", "+        expected_types: dict[str, type] = {\r\n"]
[0.000, "o", "+            \"array\": list,\r\n"]
[0.000, "o", "+            \"boolean\": bool,\r\n+            \"integer\": int,\r\n+            \"object\": dict,\r\n+            \"string\": str,\r\n+        }\r\n+        for dotted_path, expected_name in self.required_path_types.items():\r\n+            values = _json_path_values(actual_request, dotted_path)\r\n+            if not values:\r\n+                raise AssertionError(\r\n+                    f\"{phase}: golden request path missing: {dotted_path}\"\r\n+                )\r\n+            expected_type = expected_types[expected_name]\r\n+            for value in values:\r\n"]
[0.000, "o", "+                if not isinstance(value, expected_type) or (\r\n+                    expected_type is int and isinstance(value, bool)\r\n"]
[0.000, "o", "+                ):\r\n"]
[0.000, "o", "+                    raise AssertionError(\r\n"]
[0.000, "o", "+                        f\"{phase}: {dotted_path} must be {expected_name}, \"\r\n"]
[0.000, "o", "+                        f\"got {type(value).__name__}\"\r\n"]
[0.000, "o", "+                    )\r\n"]
[0.000, "o", "+\r\n"]
[0.000, "o", "+        for dotted_path in self.forbidden_paths:\r\n"]
[0.000, "o", "+            if _json_path_values(actual_request, dotted_path):\r\n+                raise AssertionError(\r\n"]
[0.000, "o", "+                    f\"{phase}: forbidden model-input path present: {dotted_path}\"\r\n"]
[0.000, "o", "+                )\r\n"]
[0.000, "o", "+\r\n"]
[0.000, "o", "+\r\n"]
[0.000, "o", " # ---------------------------------------------------------------------------\r\n"]
