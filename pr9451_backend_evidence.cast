[0.000, "o", "+            \"rewards_box\": {\r\n"]
[0.000, "o", "+                \"current_xp\": 999999,\r\n"]
[0.000, "o", "+                \"new_level\": 99,\r\n"]
[0.000, "o", "+                \"loot\": [\"sword\"],\r\n"]
[0.000, "o", "+            }\r\n"]
[0.000, "o", "+        }\r\n"]
[0.000, "o", "+    }\r\n+\r\n"]
[0.000, "o", "+    structured_fields_utils.strip_model_progression_fields(structured_fields)\r\n"]
[0.000, "o", "+    rewards_box, _ = rewards_engine.canonicalize_rewards(\r\n+        structured_fields, state, original_state\r\n"]
