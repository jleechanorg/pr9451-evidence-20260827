[0.000, "o", "-        # (6500). target_level=4 in rewards_pending is the canonical pending\r\n"]
[0.000, "o", "-        # transition the conclude prompt instructs the model to commit. The LLM\r\n-        # response below emits `level: 4` itself — proving the model-authored\r\n"]
