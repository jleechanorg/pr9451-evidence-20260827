[0.000, "o", "-def test_commit_boundary_single_transition_contract():\r\n"]
[0.000, "o", "-    \"\"\"The product chose the lean auto-apply transition (2026-07-26 design\r\n-    doc; PR #8489): the CROSSING turn commits the full sheet. This replaces\r\n"]
[0.000, "o", "-    the former blocker-sentinel test (which held the suite red while the\r\n"]
[0.000, "o", "-    prompts carried BOTH entry-commit and finish-commit contracts) per that\r\n-    sentinel's own instruction, now that the contradiction is resolved.\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-    Asserts the chosen contract is present and the retired finish-commit\r\n"]
[0.000, "o", "-    contract stays absent -- reintroducing finish-commit language should\r\n"]
[0.000, "o", "-    fail this test loudly.\r\n-    \"\"\"\r\n"]
[0.000, "o", "-    general = _load(\"level_up_instruction.md\")\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-    # Chosen contract present (crossing/grant commits the complete sheet).\r\n"]
[0.000, "o", "-    assert \"Crossing Turn Commits Full Sheet\" in general\r\n"]
[0.000, "o", "-    assert \"Full Sheet Committed at Grant Time\" in general\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-    # Retired finish-commit contract absent everywhere it used to live.\r\n"]
[0.000, "o", "-    override = _load(\"level_up_modal_override_instruction.md\")\r\n"]
[0.000, "o", "-    conclude = _load(\"level_up_conclude_instruction.md\")\r\n"]
[0.000, "o", "-    for retired in (\r\n"]
[0.000, "o", "-        \"Commit all mechanical level-up changes only on the finish turn\",\r\n-        \"Pre-Finish Mechanical Display Is Current-State Only\",\r\n"]
[0.000, "o", "-    ):\r\n"]
[0.000, "o", "-        assert retired not in general\r\n"]
[0.000, "o", "-        assert retired not in override\r\n"]
[0.000, "o", "-        assert retired not in conclude\r\n"]
[0.000, "o", "-    assert \"It does not commit\" not in override\r\n-\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-def test_damage_preserving_hp_rule_remains_mechanically_visible():\r\n"]
[0.000, "o", "-    \"\"\"Pin the only explicit injured-character HP rule.\"\"\"\r\n"]
