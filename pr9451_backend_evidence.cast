[0.000, "o", "+\r\n+\r\n"]
[0.000, "o", "+def _write_expectation(tmp_path):\r\n"]
[0.000, "o", "+    path = tmp_path / \"request.json\"\r\n"]
[0.000, "o", "+    path.write_text(\r\n"]
[0.000, "o", "+        json.dumps(\r\n"]
[0.000, "o", "+            {\r\n+                \"source\": {\"request_id\": \"bq-request\"},\r\n"]
[0.000, "o", "+                \"required_top_level_keys\": [\"game_mode\", \"game_state\"],\r\n"]
[0.000, "o", "+                \"required_path_types\": {\r\n"]
[0.000, "o", "+                    \"game_mode\": \"string\",\r\n"]
[0.000, "o", "+                    \"game_state.player_character_data\": \"object\",\r\n+                },\r\n"]
[0.000, "o", "+                \"forbidden_paths\": [\r\n"]
[0.000, "o", "+                    \"game_state.rewards_box\",\r\n"]
[0.000, "o", "+                    \"story_history.*.level_up_session\",\r\n+                ],\r\n"]
[0.000, "o", "+            }\r\n"]
[0.000, "o", "+        ),\r\n"]
[0.000, "o", "+        encoding=\"utf-8\",\r\n"]
[0.000, "o", "+    )\r\n"]
[0.000, "o", "+    return GoldenLLMRequestExpectation.from_file(path)\r\n"]
[0.000, "o", "+\r\n"]
[0.000, "o", "+\r\n+def test_golden_request_expectation_accepts_backend_shape(tmp_path):\r\n"]
[0.000, "o", "+    expectation = _write_expectation(tmp_path)\r\n"]
[0.000, "o", "+    expectation.assert_matches(\r\n"]
[0.000, "o", "+        {\r\n+            \"game_mode\": \"character\",\r\n+            \"game_state\": {\"player_character_data\": {\"level\": 2}},\r\n+        },\r\n+        phase=\"crossing_l2\",\r\n+    )\r\n+\r\n"]
[0.000, "o", "+\r\n"]
[0.000, "o", "+def test_golden_request_expectation_rejects_forbidden_model_input(tmp_path):\r\n"]
[0.000, "o", "+    expectation = _write_expectation(tmp_path)\r\n"]
[0.000, "o", "+    with pytest.raises(AssertionError, match=\"game_state.rewards_box\"):\r\n"]
[0.000, "o", "+        expectation.assert_matches(\r\n"]
[0.000, "o", "+            {\r\n"]
[0.000, "o", "+                \"game_mode\": \"character\",\r\n"]
[0.000, "o", "+                \"game_state\": {\r\n"]
[0.000, "o", "+                    \"player_character_data\": {\"level\": 2},\r\n"]
[0.000, "o", "+                    \"rewards_box\": {\"xp_gained\": 102},\r\n+                },\r\n"]
[0.000, "o", "+            },\r\n"]
[0.000, "o", "+            phase=\"crossing_l2\",\r\n"]
[0.000, "o", "+        )\r\n"]
[0.000, "o", "+\r\n+\r\n"]
