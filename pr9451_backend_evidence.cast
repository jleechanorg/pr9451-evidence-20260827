[0.000, "o", "-\r\n"]
[0.000, "o", "-    assert \"health.hp=17\" in general\r\n"]
[0.000, "o", "-    assert \"health.hp_max=20\" in general\r\n-\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-# ---------------------------------------------------------------------------\r\n"]
[0.000, "o", "-# Tests: grant-turn (first modal) complete-package mandate\r\n"]
[0.000, "o", "-# ---------------------------------------------------------------------------\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-\r\n-def test_first_modal_mandates_complete_package_generically():\r\n"]
[0.000, "o", "-    \"\"\"level_up_instruction.md must require the complete recommended package on\r\n"]
[0.000, "o", "-    the first modal response using generic language (not class-specific lists).\"\"\"\r\n"]
[0.000, "o", "+def test_grant_contract_uses_complete_pcd_as_mechanical_surface():\r\n"]
[0.000, "o", "+    \"\"\"A threshold crossing writes the complete resulting character sheet.\"\"\"\r\n"]
[0.000, "o", "     text = _load(\"level_up_instruction.md\")\r\n"]
[0.000, "o", "-    # The Recommended-package narrative must be required\r\n"]
[0.000, "o", "-    assert \"Recommended package\" in text, (\r\n"]
[0.000, "o", "-        \"level_up_instruction.md must require 'Recommended package:' label in \"\r\n"]
[0.000, "o", "-        \"first modal response (M-A)\"\r\n-    )\r\n"]
[0.000, "o", "-    # The mandate must cover HP + features + spells together\r\n"]
[0.000, "o", "-    has_hp = \"hp\" in text.lower() or \"hit point\" in text.lower()\r\n"]
[0.000, "o", "-    has_features = \"features\" in text.lower() or \"class features\" in text.lower()\r\n"]
[0.000, "o", "-    has_spells = \"spell\" in text.lower()\r\n"]
[0.000, "o", "-    assert has_hp, (\r\n-        \"level_up_instruction.md must cover HP in the first-modal package mandate (M-A)\"\r\n"]
[0.000, "o", "-    )\r\n"]
[0.000, "o", "-    assert has_features, (\r\n"]
[0.000, "o", "-        \"level_up_instruction.md must cover class features in the first-modal package mandate (M-A)\"\r\n"]
[0.000, "o", "-    )\r\n"]
[0.000, "o", "-    assert has_spells, (\r\n"]
[0.000, "o", "-        \"level_up_instruction.md must cover spells in the first-modal package mandate (M-A)\"\r\n"]
[0.000, "o", "-    )\r\n-\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-def test_modal_override_requires_automatic_gains_section():\r\n"]
[0.000, "o", "-    \"\"\"The modal-override instruction must mandate an 'Automatic gains:' sentence\r\n-    listing ALL automatic class gains for the current character — generically.\"\"\"\r\n"]
[0.000, "o", "-    text = _load(\"level_up_modal_override_instruction.md\")\r\n"]
[0.000, "o", "-    assert \"Automatic gains:\" in text, (\r\n-        \"modal-override must mandate 'Automatic gains:' in the first-modal narrative \"\r\n-        \"(M-A: complete package requirement)\"\r\n-    )\r\n-    # The mandate must reference class+level context, not a hardcoded class name\r\n-    # Check that it references class/subclass generically (not only Paladin)\r\n-    lower = text.lower()\r\n-    # Should reference class context generically\r\n-    has_generic_class_ref = \"class\" in lower and \"subclass\" in lower\r\n-    assert has_generic_class_ref, (\r\n-        \"modal-override must reference the character's class/subclass generically, \"\r\n"]
[0.000, "o", "-        \"not only for a specific class (avoids #7467 over-fit)\"\r\n"]
[0.000, "o", "-    )\r\n-\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-def test_first_modal_covers_all_four_components():\r\n"]
[0.000, "o", "-    \"\"\"Both level_up_instruction.md and modal_override must together mandate the\r\n"]
[0.000, "o", "-    four M-A components: level, HP, features, spells in the grant turn.\"\"\"\r\n"]
[0.000, "o", "-    inst = _load(\"level_up_instruction.md\")\r\n-    override = _load(\"level_up_modal_override_instruction.md\")\r\n"]
[0.000, "o", "-    combined = inst + \"\\n\" + override\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-    lower = combined.lower()\r\n-    assert \"level\" in lower, \"Must mention level commit in grant turn\"\r\n"]
[0.000, "o", "-    assert \"hp\" in lower or \"hit point\" in lower, \"Must mention HP in grant turn\"\r\n"]
[0.000, "o", "-    assert \"feature\" in lower, \"Must mention class features in grant turn\"\r\n"]
[0.000, "o", "-    assert \"spell\" in lower, \"Must mention spells in grant turn\"\r\n"]
[0.000, "o", "-    assert \"choice\" in lower or \"offered_choice\" in lower, (\r\n-        \"Must mention offered choices in grant turn\"\r\n"]
[0.000, "o", "-    )\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-\r\n-# ---------------------------------------------------------------------------\r\n"]
[0.000, "o", "-# Tests: generic wording (no class-specific over-fit)\r\n"]
[0.000, "o", "-# ---------------------------------------------------------------------------\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-\r\n-def test_conclude_does_not_name_paladin_only():\r\n"]
[0.000, "o", "-    \"\"\"level_up_conclude_instruction.md must not be Paladin-specific.\r\n-    Any class-specific example must be presented as an example, not as the rule.\r\n"]
[0.000, "o", "-    The rule itself must be class-generic.\"\"\"\r\n"]
[0.000, "o", "-    text = _load(\"level_up_conclude_instruction.md\")\r\n"]
[0.000, "o", "-    lower = text.lower()\r\n"]
[0.000, "o", "-    # If \"paladin\" appears, it must be in an example context (e.g. \"For a Paladin...\")\r\n"]
[0.000, "o", "-    # and the surrounding text must also apply generically (i.e., \"class\" must appear too)\r\n-    if \"paladin\" in lower:\r\n"]
[0.000, "o", "-        assert \"class\" in lower, (\r\n"]
[0.000, "o", "-            \"level_up_conclude_instruction.md contains 'paladin' but must also use \"\r\n-            \"generic 'class' language to avoid over-fit (lesson from bug #7467)\"\r\n"]
[0.000, "o", "-        )\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-def test_modal_override_finish_not_paladin_only():\r\n-    \"\"\"The modal-override finish section must be class-generic, not Paladin-only.\"\"\"\r\n"]
[0.000, "o", "-    text = _load(\"level_up_modal_override_instruction.md\")\r\n"]
[0.000, "o", "-    finish_idx = text.find(\"finish_level_up_return_to_game\")\r\n"]
[0.000, "o", "-    assert finish_idx != -1\r\n"]
[0.000, "o", "-    finish_section = text[finish_idx:].lower()\r\n"]
[0.000, "o", "-    if \"paladin\" in finish_section:\r\n"]
[0.000, "o", "-        assert \"class\" in finish_section, (\r\n-            \"modal-override finish section contains 'paladin' but must also use \"\r\n"]
[0.000, "o", "-            \"generic 'class' language to prevent over-fit (lesson from bug #7467)\"\r\n-        )\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-\r\n-# ---------------------------------------------------------------------------\r\n"]
[0.000, "o", "-# Tests: conclude must write pending selections to PCD\r\n"]
[0.000, "o", "-# ---------------------------------------------------------------------------\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-def test_conclude_mandates_pending_selections_transfer():\r\n"]
[0.000, "o", "-    \"\"\"The conclude instruction must require transferring pending_level_up_selections\r\n"]
[0.000, "o", "-    into player_character_data on the finish turn (so HP/spells from modal are committed).\"\"\"\r\n"]
[0.000, "o", "-    text = _load(\"level_up_conclude_instruction.md\")\r\n-    has_pending_transfer = any(\r\n"]
[0.000, "o", "-        kw in text.lower()\r\n"]
[0.000, "o", "-        for kw in [\r\n"]
[0.000, "o", "-            \"pending_level_up_selections\",\r\n-            \"pending selections\",\r\n"]
[0.000, "o", "-            \"selected spells\",\r\n"]
[0.000, "o", "-            \"selected hp\",\r\n"]
[0.000, "o", "-        ]\r\n"]
[0.000, "o", "-    )\r\n-    assert has_pending_transfer, (\r\n"]
[0.000, "o", "-        \"level_up_conclude_instruction.md must require writing pending_level_up_selections \"\r\n"]
[0.000, "o", "-        \"into player_character_data on the finish turn (M-A: complete sheet)\"\r\n"]
[0.000, "o", "-    )\r\n"]
[0.000, "o", "-\r\n-\r\n"]
[0.000, "o", "-# ---------------------------------------------------------------------------\r\n"]
[0.000, "o", "-# Tests: lean author-at-grant contract (PR #8489, corrected 2026-07-26)\r\n"]
[0.000, "o", "-#\r\n"]
[0.000, "o", "-# The lean contract requires that on the grant turn (level_up_now) the model\r\n"]
[0.000, "o", "-# AUTHORS THE COMPLETE post-level-up character sheet immediately and mirrors\r\n"]
[0.000, "o", "-# the chosen defaults into level_up_session (from_level/to_level/source/\r\n"]
[0.000, "o", "-# selections) and pending_level_up_selections. `level_up_session.review_open`\r\n-# and `.status` are SERVER-OWNED (apply_level_up() / close_review() in\r\n"]
[0.000, "o", "-# mvp_site/level_up_session.py) -- the model must never author either field.\r\n"]
[0.000, "o", "-#\r\n"]
[0.000, "o", "-# CORRECTION (2026-07-26): this section previously asserted the grant turn\r\n"]
[0.000, "o", "-# writes review_open=false / status=\"complete\" (sealed immediately) and that\r\n"]
[0.000, "o", "-# an amend reseals in the same response. That was the REJECTED design. The\r\n-# operator's explicit direction -- \"i needto say apply choies and commit etc\r\n"]
[0.000, "o", "-# to leavet he model [modal]\" -- requires a real, separate commit step: the\r\n-# grant turn leaves review_open=True (apply_level_up() in\r\n-# mvp_site/level_up_session.py), an amend applies a selection WITHOUT\r\n"]
[0.000, "o", "-# resealing (mvp_site/tests/test_level_up_amend_call_site.py::\r\n-# test_amend_applies_selections_and_leaves_the_review_open pins this), and\r\n"]
[0.000, "o", "-# ONLY the player explicitly selecting `finish_level_up_return_to_game`\r\n-# (close_review()) seals the review. See\r\n"]
[0.000, "o", "-# docs/superpowers/specs/2026-07-26-automatic-level-up-crossing-turn-design.md.\r\n"]
[0.000, "o", "-# These tests assert the prompt files contain the corrected key phrases and\r\n"]
[0.000, "o", "-# do NOT contain the old deferred-application phrasing removed in T1/T2, nor\r\n"]
[0.000, "o", "-# the rejected \"amend reseals immediately\" phrasing.\r\n-# ---------------------------------------------------------------------------\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-def test_lean_contract_modal_override_authors_complete_sheet_at_grant():\r\n"]
[0.000, "o", "-    \"\"\"level_up_modal_override_instruction.md must state that the grant turn\r\n-    (level_up_now) AUTHORS THE COMPLETE post-level-up character sheet\r\n"]
[0.000, "o", "-    immediately in state_updates.player_character_data.\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-    Lean contract: the sheet is committed at grant, not deferred to finish.\r\n"]
[0.000, "o", "-    \"\"\"\r\n"]
[0.000, "o", "-    text = _load(\"level_up_modal_override_instruction.md\")\r\n-    assert \"AUTHORS THE COMPLETE\" in text, (\r\n"]
[0.000, "o", "-        \"level_up_modal_override_instruction.md must contain the lean author-at-grant \"\r\n"]
[0.000, "o", "-        \"mandate 'AUTHORS THE COMPLETE' on the level_up_now grant turn (PR #8489)\"\r\n-    )\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-def test_lean_contract_modal_override_grant_does_not_author_review_open_false():\r\n"]
[0.000, "o", "-    \"\"\"level_up_modal_override_instruction.md must NOT instruct the model to\r\n"]
[0.000, "o", "-    write review_open=false on the grant turn's level_up_now context.\r\n-\r\n"]
[0.000, "o", "-    CORRECTED CONTRACT (2026-07-26): apply_level_up() (the grant reducer in\r\n"]
[0.000, "o", "-    mvp_site/level_up_session.py) leaves review_open=True -- the sheet is\r\n"]
[0.000, "o", "-    committed but the review stays open so the player can still amend it.\r\n"]
[0.000, "o", "-    The old assertion here required review_open=false at grant (\"the modal\r\n"]
[0.000, "o", "-    does NOT force-open... the complete + editable contract seals the review\r\n"]
[0.000, "o", "-    at grant\") -- that was the REJECTED design; sealing at grant makes the\r\n"]
[0.000, "o", "-    operator's required amend-then-commit step unreachable. review_open is\r\n-    server-owned end to end; the prompt must not tell the model to author it.\r\n"]
[0.000, "o", "-    \"\"\"\r\n"]
[0.000, "o", "-    text = _load(\"level_up_modal_override_instruction.md\")\r\n-    grant_idx = text.find(\"### level_up_now\")\r\n"]
[0.000, "o", "-    assert grant_idx != -1, (\r\n-        \"level_up_modal_override_instruction.md must have a level_up_now \"\r\n"]
[0.000, "o", "-        \"SELECTED_CHOICE_CONTEXT section\"\r\n"]
[0.000, "o", "-    )\r\n"]
[0.000, "o", "-    next_heading_idx = text.find(\"### level_up_review\", grant_idx)\r\n-    grant_section = text[grant_idx:next_heading_idx]\r\n"]
[0.000, "o", "-    assert \"review_open=false\" not in grant_section, (\r\n-        \"level_up_modal_override_instruction.md's level_up_now context must not \"\r\n"]
[0.000, "o", "-        \"instruct the model to author review_open=false at grant -- the reducer \"\r\n"]
[0.000, "o", "-        \"leaves the review open (corrected contract, 2026-07-26)\"\r\n"]
[0.000, "o", "-    )\r\n"]
[0.000, "o", "-    assert \"server-owned\" in grant_section, (\r\n"]
[0.000, "o", "-        \"level_up_modal_override_instruction.md's level_up_now context must \"\r\n-        \"explain that review_open/status are server-owned, not model-authored\"\r\n"]
[0.000, "o", "-    )\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-def test_lean_contract_modal_override_does_not_author_session_status():\r\n"]
[0.000, "o", "-    \"\"\"level_up_modal_override_instruction.md must NOT instruct the model to\r\n"]
[0.000, "o", "-    write level_up_session.status at all -- it is server-owned.\r\n-\r\n"]
[0.000, "o", "-    CORRECTED CONTRACT (2026-07-26): the old assertion here required\r\n"]
[0.000, "o", "-    status='complete' at grant (\"the complete + editable contract seals the\r\n"]
[0.000, "o", "-    session immediately at grant\"). The actual grant reducer (apply_level_up()\r\n"]
[0.000, "o", "-    in mvp_site/level_up_session.py) writes status=STATUS_IN_PROGRESS, not\r\n-    \"complete\" -- only close_review() (triggered by the player explicitly\r\n"]
[0.000, "o", "-    picking finish_level_up_return_to_game) sets status=COMPLETE. Telling the\r\n"]
[0.000, "o", "-    model to author status=\"complete\" at grant was simply wrong; the model\r\n"]
[0.000, "o", "-    must not author level_up_session.status in either direction.\r\n"]
[0.000, "o", "-    \"\"\"\r\n"]
