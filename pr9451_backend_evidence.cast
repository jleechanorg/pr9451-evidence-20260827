[0.002, "o", "diff --git a/mvp_site/tests/test_levelup_prompt_full_sheet.py b/mvp_site/tests/test_levelup_prompt_full_sheet.py\r\nindex 1df448bc85..679aed09c6 100644\r\n--- a/mvp_site/tests/test_levelup_prompt_full_sheet.py\r\n+++ b/mvp_site/tests/test_levelup_prompt_full_sheet.py\r\n@@ -1,679 +1,117 @@\r\n-\"\"\"Contract tests for level-up v2 M-A: full-sheet mandate.\r\n-\r\n-These tests verify the prompt files contain the behavioral rules required by\r\n-the M-A milestone. They also keep the exact-head entry-vs-finish and HP-policy\r\n-contradictions mechanically visible until production chooses one contract.\r\n-\r\n-TDD coverage:\r\n-- Finish turn: complete-sheet mandate is present in conclude / modal-override\r\n-- Finish turn: rewards_box.new_level-only is explicitly forbidden\r\n-- Grant turn: first-modal Recommended-package narrative mandated generically\r\n-- Generic wording: no class-specific lists that could over-fit one class\r\n-- Spells on finish: commit selected spells explicitly mandated\r\n"]
[0.000, "o", "-- Features on finish: commit gained features explicitly mandated\r\n-- Contract audit: entry-commit and finish-commit instructions both remain visible\r\n"]
