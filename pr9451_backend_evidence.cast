[0.000, "o", "-    },\r\n"]
[0.000, "o", "-    {\r\n"]
[0.000, "o", "-      \"text\": \"[Character Creation Mode - Story begins after character is complete]\",\r\n-      \"actor\": \"gemini\",\r\n"]
[0.000, "o", "-      \"sequence_id\": 2\r\n"]
[0.000, "o", "-    },\r\n"]
[0.000, "o", "-    {\r\n-      \"text\": \"I want to create my character\",\r\n"]
[0.000, "o", "-      \"mode\": \"character\",\r\n-      \"actor\": \"user\",\r\n"]
