[0.000, "o", "-def test_new_level_only_explicitly_forbidden():\r\n"]
[0.000, "o", "-    \"\"\"At least one prompt file must explicitly state that emitting only\r\n"]
[0.000, "o", "-    rewards_box.new_level without the full player_character_data sheet is\r\n"]
[0.000, "o", "-    insufficient / forbidden (M-A anti-pattern guard).\"\"\"\r\n"]
[0.000, "o", "-    texts = [\r\n"]
[0.000, "o", "-        _load(\"level_up_conclude_instruction.md\"),\r\n"]
[0.000, "o", "-        _load(\"level_up_modal_override_instruction.md\"),\r\n"]
[0.000, "o", "-        _load(\"level_up_instruction.md\"),\r\n"]
[0.000, "o", "-    ]\r\n-    combined = \"\\n\".join(texts).lower()\r\n"]
[0.000, "o", "-    has_guard = any(\r\n"]
[0.000, "o", "-        phrase in combined\r\n"]
[0.000, "o", "-        for phrase in [\r\n"]
[0.000, "o", "-            \"never advance a level by emitting only\",\r\n"]
[0.000, "o", "-            \"new_level alone\",\r\n"]
[0.000, "o", "-            \"rewards_box.new_level is not sufficient\",\r\n"]
[0.000, "o", "-            \"not sufficient to emit only\",\r\n"]
[0.000, "o", "-            \"only rewards_box.new_level\",\r\n"]
[0.000, "o", "-        ]\r\n"]
[0.000, "o", "-    )\r\n"]
[0.000, "o", "-    assert has_guard, (\r\n-        \"At least one level-up prompt must explicitly forbid advancing a level by \"\r\n"]
[0.000, "o", "-        \"emitting only rewards_box.new_level without the full PCD sheet (M-A)\"\r\n"]
[0.000, "o", "-    )\r\n-\r\n"]
