[0.000, "o", "+\r\n+def test_server_owns_session_lifecycle_and_projection_fields():\r\n+    \"\"\"Prompts keep session bookkeeping and display projections server-owned.\"\"\"\r\n+    instruction = \" \".join(_load(\"level_up_instruction.md\").split())\r\n+    override = \" \".join(_load(\"level_up_modal_override_instruction.md\").split())\r\n+    conclude = \" \".join(_load(\"level_up_conclude_instruction.md\").split())\r\n+\r\n"]
[0.000, "o", "+    assert \"Never author server-owned review/session/control fields\" in instruction\r\n"]
[0.000, "o", "+    assert \"server owns persistence, review bookkeeping, and display projections\" in instruction\r\n+    assert \"Do not expose or author persistence, review, session, threshold, badge, or control metadata\" in override\r\n+    assert \"server owns review persistence and display projections\" in override\r\n+    assert \"server owns review persistence, sealing, headers, and display projections\" in conclude\r\n+\r\n+\r\n+def test_level_up_prompts_have_no_retired_model_authored_surfaces():\r\n+    \"\"\"Legacy receipts, signals, pending state, and reward projections stay absent.\"\"\"\r\n+    retired_surfaces = (\r\n+        \"level_up_session\",\r\n+        \"level_up_signal\",\r\n+        \"pending_level_up_selections\",\r\n+        \"rewards_box\",\r\n+        \"level_up_available\",\r\n"]
[0.000, "o", "+        \"review_open=\",\r\n+        \"status=\",\r\n+    )\r\n"]
