[0.000, "o", "--- /dev/null\r\n+++ b/mvp_site/tests/test_end2end/fixtures/level_up_auto_apply/l4_amendment.response.json\r\n@@ -0,0 +1,61 @@\r\n+{\r\n+  \"narrative\": \"Morning (08:32:06:000004) in the Second Chamber of the Divine Training Gauntlet—The golden aura of the level-up stasis vibrates with a low, tectonic hum as Test Character selects the path of physical dominance. You feel your muscles pull taut, the fibers of your being knitting together with the density of iron as the Gauntlet's Echo channels raw celestial power into your frame. The weight of your longsword, once substantial, now feels light and responsive in your hand—an extension of a body that has surpassed its mortal limits. The vision of the shadowed crown pulses one final time, its darkness seemingly intimidated by the sheer physical presence you now project. 'Might is the foundation upon which your justice shall stand,' the Echo intones, its light beginning to fade back into the chamber's white walls. Your Strength (18) is now a mountain that the constructs"]
[0.000, "o", " of the gauntlet must climb.\",\r\n+  \"planning_block\": {\r\n+    \"thinking\": \"Test Character has committed her Level 4 Ability Score Improvement to Strength, increasing it from 16 to 18. This choice has been staged in her character sheet, reflecting an increase to her melee attack bonus (+7 base, +9 with Sacred Weapon) and her damage bonus (+4). The review is now ready to be finalized, which will return her to the active combat encounter with the Sparring Construct Beta. Time remains frozen at the microsecond level during this selection.\",\r\n+    \"context\": \"Level 4 Paladin Advancement Finalization\",\r\n+    \"choices\": [\r\n+      {\r\n+        \"id\": \"finish_level_up_return_to_game\",\r\n+        \"text\": \"Confirm and Return to Story\",\r\n+        \"description\": \"Seal the Strength improvement and resume the battle with Construct Beta.\",\r\n+        \"risk_level\": \"safe\",\r\n+        \"pros\": [\r\n+          \"Permanent +1 bonus to Strength-based attacks and damage\",\r\n+          \"Resumes story with full Level 4 capabilities and 36 HP\"\r"]
[0.000, "o", "\r\n+        ],\r\n+        \"cons\": [\r\n+          \"Ends the ability to change Level 4 choices\"\r\n+        ],\r\n+        \"confidence\": \"high\",\r\n+        \"freeze_time\": true\r\n+      },\r\n+      {\r\n+        \"id\": \"asi_charisma\",\r\n+        \"text\": \"Change to Charisma (+2)\",\r\n+        \"description\": \"Change your selection to Charisma instead.\",\r\n+        \"risk_level\": \"safe\",\r\n+        \"pros\": [\r\n+          \"Improves Sacred Weapon and Save DCs\"\r\n+        ],\r\n+        \"cons\": [\r\n+          \"Loses the +2 Strength bonus\"\r\n+        ],\r\n+        \"confidence\": \"medium\",\r\n+        \"freeze_time\": true\r\n+      }\r\n"]
