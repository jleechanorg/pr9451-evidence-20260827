[0.000, "o", " def parse_session_header_level(text: str | None) -> int | None:\r\n"]
[0.000, "o", "@@ -59,7 +103,14 @@ def collect_session_header_contract_errors(\r\n     canonical_level: Any,\r\n     context: str,\r\n ) -> list[str]:\r\n-    \"\"\"Compare raw model and visible Status bars with persisted Firestore level.\"\"\"\r\n+    \"\"\"Compare server-owned Status bars with persisted Firestore level.\r\n"]
