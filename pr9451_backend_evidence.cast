[0.000, "o", "+        },\r\n+        \"stats\": {\r\n"]
[0.000, "o", "+            \"strength\": 14,\r\n"]
[0.000, "o", "+            \"dexterity\": 8,\r\n"]
[0.000, "o", "+            \"constitution\": 13,\r\n+            \"intelligence\": 10,\r\n"]
[0.000, "o", "+            \"wisdom\": 17,\r\n"]
