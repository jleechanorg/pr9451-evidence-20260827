[0.000, "o", "+    def test_bq_pcd_only_endpoints_commit_identical_state_and_session(  # noqa: PLR0915\r\n+        self, mock_gemini_request, mock_get_db, mock_stream\r\n+    ):\r\n"]
[0.000, "o", "+        \"\"\"Both HTTP endpoints commit one identical PCD-owned transaction.\r\n+\r\n"]
[0.000, "o", "+        GOAL: bind the backend-first parity claim to both production endpoints.\r\n+        MODIFICATION: replay one scrubbed raw-BQ-shaped SDK response through\r\n"]
[0.000, "o", "+        `/interaction` and `/interaction/stream` from identical pre-state.\r\n+        NECESSITY: separate endpoint tests can pass while projecting different\r\n"]
[0.000, "o", "+        accepted state or session data.\r\n+        INTEGRATION PROOF: reducer/projector spies must fire, both LLM seams must\r\n+        be consumed, and response, story, and persistence must agree with the\r\n"]
[0.000, "o", "+        same canonical PCD and reducer-owned session.\r\n+        \"\"\"\r\n"]
[0.000, "o", "+        self.maxDiff = None\r\n+        self._enable_real_services()\r\n"]
[0.000, "o", "+        db = FakeFirestoreClient()\r\n+        mock_get_db.return_value = db\r\n"]
[0.000, "o", "+        parity_payload = copy.deepcopy(_BQ_PCD_ONLY_RESPONSE)\r\n+        parity_payload[\"state_updates\"][\"player_character_data\"][\"model_only\"] = (\r\n"]
[0.000, "o", "+            \"reintroduce-me\"\r\n+        )\r\n"]
[0.000, "o", "+        fixture = RealisticFakeLLMResponse(json_text=json.dumps(parity_payload))\r\n+        mock_gemini_request.return_value = fixture\r\n"]
[0.000, "o", "+        mock_stream.return_value = [fixture]\r\n+\r\n"]
[0.000, "o", "+        sync_campaign = \"test-bq-pcd-only-endpoint-parity-sync\"\r\n+        stream_campaign = \"test-bq-pcd-only-endpoint-parity-stream\"\r\n"]
[0.000, "o", "+        for campaign_id in (sync_campaign, stream_campaign):\r\n+            self._seed_campaign_doc(db, campaign_id, \"BQ PCD-Only Endpoint Parity\")\r\n"]
[0.000, "o", "+            self._seed_bq_pcd_only_state(db, campaign_id)\r\n+\r\n"]
[0.000, "o", "+        with (\r\n+            patch(\r\n+                \"mvp_site.rewards_engine._apply_level_up\",\r\n"]
[0.000, "o", "+                wraps=rewards_engine._apply_level_up,\r\n+            ) as rewards_reducer_spy,\r\n"]
[0.000, "o", "+            patch(\r\n+                \"mvp_site.level_up_session.apply_level_up\",\r\n"]
[0.000, "o", "+                wraps=level_up_session.apply_level_up,\r\n+            ) as session_reducer_spy,\r\n"]
[0.000, "o", "+            patch(\r\n+                \"mvp_site.rewards_engine.canonicalize_rewards\",\r\n"]
[0.000, "o", "+                wraps=rewards_engine.canonicalize_rewards,\r\n+            ) as projector_spy,\r\n"]
[0.000, "o", "+            patch(\r\n+                \"mvp_site.llm_service.parse_structured_response\",\r\n"]
[0.000, "o", "+                wraps=llm_service.parse_structured_response,\r\n"]
[0.000, "o", "+            ) as sync_parser_spy,\r\n+            patch(\r\n"]
[0.000, "o", "+                \"mvp_site.llm_parser.parse_structured_response\",\r\n+                wraps=llm_parser.parse_structured_response,\r\n"]
[0.000, "o", "+            ) as stream_parser_spy,\r\n+            patch(\r\n+                \"mvp_site.firestore_service.persist_turn_atomic\",\r\n"]
[0.000, "o", "+                wraps=firestore_service.persist_turn_atomic,\r\n+            ) as persistence_spy,\r\n"]
[0.000, "o", "+        ):\r\n+            sync_reducer_before = (\r\n+                rewards_reducer_spy.call_count + session_reducer_spy.call_count\r\n"]
[0.000, "o", "+            )\r\n"]
[0.000, "o", "+            sync_projector_before = projector_spy.call_count\r\n+            sync_parser_before = sync_parser_spy.call_count\r\n"]
