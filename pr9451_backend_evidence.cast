[0.000, "o", "+def test_persisted_rewards_box_cannot_write_xp_back_into_pcd():\r\n+    \"\"\"Historical display state is never an authority for canonical XP.\"\"\"\r\n+    original_state = {\r\n+        \"player_character_data\": {\r\n+            \"level\": 3,\r\n+            \"experience\": {\"current\": 900, \"to_next_level\": 2700},\r\n+        },\r\n+        \"rewards_box\": {\r\n+            \"current_xp\": 999999,\r\n+            \"next_level_xp\": 9999999,\r\n+            \"loot\": [\"old trophy\"],\r\n+        },\r\n+    }\r\n"]
[0.000, "o", "+    state = copy.deepcopy(original_state)\r\n+\r\n"]
