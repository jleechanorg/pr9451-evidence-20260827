[0.000, "o", "-    text = _load(\"level_up_instruction.md\")\r\n"]
[0.000, "o", "-    assert re.search(r\"crossing turn\", text, re.I), (\r\n-        \"level_up_instruction.md must name and define the 'crossing turn' -- \"\r\n-        \"the turn on which target_level > current_level is newly true and \"\r\n-        \"the sheet is applied in that same response.\"\r\n-    )\r\n-    assert re.search(\r\n-        r\"(?is)crossing turn.{0,400}(apply|commit).{0,200}(same (turn|response)|immediately)\",\r\n-        text,\r\n-    ), (\r\n-        \"the crossing-turn rule must be imperative: apply/commit the sheet \"\r\n-        \"in the same turn/response the crossing is detected, not on a later \"\r\n-        \"turn gated by a player click.\"\r\n-    )\r\n-\r\n-\r\n-def test_god_mode_escape_hatch_stated():\r\n-    \"\"\"The crossing-turn narrative must promise the choices are editable via god mode later.\"\"\"\r\n-    text = _load(\"level_up_instruction.md\")\r\n-    assert re.search(r\"god mode\", text, re.I), (\r\n-        \"level_up_instruction.md must mention god mode as the escape hatch \"\r\n-        \"for changing auto-applied level-up choices later.\"\r\n-  "]
[0.000, "o", "  )\r\n-    hatch = re.search(\r\n-        r\"(?is)(?:(?:changed?|edit(?:ed)?|amend(?:ed)?).{0,120}(?:later|any time|afterwards?).{0,200}god mode\"\r\n-        r\"|god mode.{0,200}(?:changed?|edit(?:ed)?|amend(?:ed)?).{0,120}(?:later|any time))\",\r\n-        text,\r\n-    )\r\n-    assert hatch, (\r\n-        \"level_up_instruction.md must state that the player can change the \"\r\n-        \"auto-applied level-up choices later, at any time, through god mode \"\r\n-        \"-- this is the required escape hatch that makes the narrow \"\r\n-        \"crossing-turn edit window acceptable per the governing spec §6b.\"\r\n-    )\r\n-\r\n-\r\n-def test_multi_level_crossing_single_summary_rule():\r\n-    \"\"\"Multiple thresholds crossed at once must apply fully, in one summary, never banked.\"\"\"\r\n-    text = _load(\"level_up_instruction.md\")\r\n-    assert re.search(r\"(?i)never\\s+(leave|left|leaves)\\s+.{0,20}xp\\s+banked\", text), (\r\n-        \"level_up_instruction.md must explicitly forbid leaving XP banked \"\r\n-        \"when multiple level thresholds are crossed"]
[0.001, "o", " in one turn.\"\r\n-    )\r\n-    assert re.search(\r\n-        r\"(?i)one\\s+summary\\s+paragraph|single\\s+summary\\s+paragraph\", text\r\n-    ), (\r\n-        \"level_up_instruction.md must require a single summary paragraph \"\r\n-        \"covering the whole multi-level jump, not a per-level wizard.\"\r\n-    )\r\n-\r\n-\r\n-def test_applies_on_all_turn_types_including_god_mode_and_time_frozen():\r\n-    \"\"\"The crossing-turn apply rule must explicitly cover god-mode and time-frozen turns.\"\"\"\r\n-    text = _load(\"level_up_instruction.md\")\r\n-    failure_reason = (\r\n-        \"level_up_instruction.md must state that the crossing-turn apply \"\r\n-        \"rule holds on god-mode turns and time-frozen turns too -- narrower \"\r\n-        \"than (and distinct from) the existing rule that dice-roll XP is \"\r\n-        \"not *awarded* on those turns.\"\r\n-    )\r\n-    assert re.search(r\"(?i)god.?mode\", text), failure_reason\r\n-    assert re.search(r\"(?i)time.?froz(e|en)\", text), failure_reason\r\n-\r\n-\r\n-def test_fail_closed_no_partial_sheet_rule_present():\r\n-  "]
