[0.000, "o", "-    AUTH_PATCH_TARGET = \"mvp_site.main.auth.verify_id_token\"\r\n"]
[0.000, "o", "-    TEST_USER_ID = \"test-user-level-up-modal-exit\"\r\n"]
[0.000, "o", "-\r\n-    def _game_state_ref(self, db, campaign_id):\r\n-        return (\r\n-            db.collection(\"users\")\r\n-            .document(self.TEST_USER_ID)\r\n-            .collection(\"campaigns\")\r\n-            .document(campaign_id)\r\n-            .collection(\"game_states\")\r\n-            .document(\"current_state\")\r\n-        )\r\n-\r\n-    def _seed_campaign_doc(self, db, campaign_id, title):\r\n"]
[0.000, "o", "-        db.collection(\"users\").document(self.TEST_USER_ID).collection(\r\n-            \"campaigns\"\r\n-        ).document(campaign_id).set(\r\n"]
[0.000, "o", "-            {\r\n"]
[0.000, "o", "-                \"title\": title,\r\n"]
[0.000, "o", "-                \"setting\": \"Test Realm\",\r\n"]
