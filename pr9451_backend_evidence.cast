[0.000, "o", "-    return (PROMPTS_DIR / filename).read_text(encoding=\"utf-8\")\r\n-\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-def test_no_entry_offer_language_remains():\r\n"]
[0.000, "o", "-    \"\"\"The old two-turn ('offer, then apply on click') model must be gone.\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-    \"entry offer only\" was the prompt's own name for the pre-apply turn; its\r\n"]
[0.000, "o", "-    presence anywhere means a pending, unapplied state is still being\r\n"]
[0.000, "o", "-    described as legal.\r\n"]
[0.000, "o", "-    \"\"\"\r\n-    text = _load(\"level_up_instruction.md\")\r\n-    assert \"entry offer\" not in text.lower(), (\r\n-        \"level_up_instruction.md still describes an 'entry offer' turn -- \"\r\n-        \"the crossing-turn contract has no turn where a level-up is merely \"\r\n-        \"offered and not yet applied.\"\r\n-    )\r\n-\r\n-\r\n-def test_no_first_turn_present_choice_branch():\r\n-    \"\"\"The decision tree must not route to 'present the level_up_now choice'.\r\n-\r\n-    This exact branch is what produced the observed bug: a first turn that\r\n-    shows the button, and only a *second* turn (after a click) that applies\r\n-    the sheet.\r\n-    \"\"\"\r\n-    text = _load(\"level_up_instruction.md\")\r\n-    assert not re.search(r\"present\\s+level_up_now\\s+choice\", text, re.I), (\r\n"]
[0.000, "o", "-        \"level_up_instruction.md still instructs presenting `level_up_now` \"\r\n-        \"as a clickable choice. Per the crossing-turn spec there is no \"\r\n-        \"button: the sheet applies the same turn XP crosses the threshold.\"\r\n"]
[0.000, "o", "-    )\r\n-    assert not re.search(\r\n"]
[0.000, "o", "-        r\"first turn.*level_up_pending\\s*=\\s*true.*level_up_in_progress\\s*=\\s*false\",\r\n-        text,\r\n"]
[0.000, "o", "-        re.I,\r\n-    ), (\r\n"]
[0.000, "o", "-        \"the decision tree still has a distinct 'first turn' branch separate \"\r\n"]
[0.000, "o", "-        \"from the apply branch -- these must be merged into one crossing-turn \"\r\n"]
[0.000, "o", "-        \"branch that applies immediately.\"\r\n-    )\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-\r\n-def test_no_level_up_now_button_label_rule():\r\n"]
[0.000, "o", "-    \"\"\"The 'Level Up to Level <N>' button-label rule must be removed.\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-    That rule only makes sense if `level_up_now` is shown to the player as a\r\n"]
[0.000, "o", "-    clickable planning_block choice. Under crossing-turn auto-apply, it is\r\n"]
[0.000, "o", "-    never shown, so mandating its visible label text is dead instruction\r\n"]
[0.000, "o", "-    that contradicts \"no button\".\r\n"]
[0.000, "o", "-    \"\"\"\r\n-    text = _load(\"level_up_instruction.md\")\r\n"]
[0.000, "o", "-    assert \"Level Up to Level <N>\" not in text, (\r\n"]
[0.000, "o", "-        \"level_up_instruction.md still mandates a visible button label for \"\r\n"]
[0.000, "o", "-        \"`level_up_now` ('Level Up to Level <N>'). Under the crossing-turn \"\r\n"]
[0.000, "o", "-        \"contract this choice is never presented to the player.\"\r\n"]
[0.000, "o", "-    )\r\n-\r\n"]
[0.000, "o", "-\r\n"]
