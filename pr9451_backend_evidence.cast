[0.000, "o", "-            }\r\n-        )\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-    def _seed_canonical_session_level_up_state(\r\n"]
[0.000, "o", "-        self,\r\n-        db,\r\n"]
