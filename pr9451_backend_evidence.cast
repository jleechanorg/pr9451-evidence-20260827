[0.000, "o", "+    def test_rejected_skipped_level_restores_paired_experience(self):\r\n+        \"\"\"Replay the malformed PCD pair from native Gemini request 58da5940.\"\"\"\r\n"]
[0.000, "o", "+        original_state = {\r\n"]
[0.000, "o", "+            \"player_character_data\": {\r\n"]
[0.000, "o", "+                \"level\": 1,\r\n+                \"experience\": {\"current\": 0, \"to_next_level\": 300},\r\n"]
[0.000, "o", "+            }\r\n"]
[0.000, "o", "+        }\r\n"]
[0.000, "o", "+        malformed_pair = {\r\n"]
[0.000, "o", "+            \"player_character_data\": {\r\n"]
[0.000, "o", "+                \"level\": 3,\r\n"]
[0.000, "o", "+                \"experience\": {\r\n"]
[0.000, "o", "+                    \"current\": 1530,\r\n"]
[0.000, "o", "+                    \"needed_for_next_level\": 2700,\r\n"]
[0.000, "o", "+                    \"to_next_level\": 1170,\r\n"]
[0.000, "o", "+                },\r\n+            }\r\n"]
[0.000, "o", "+        }\r\n"]
[0.000, "o", "+\r\n"]
[0.000, "o", "+        for guard in (\r\n"]
[0.000, "o", "+            rewards_engine.block_unauthorized_level_mutations,\r\n"]
[0.000, "o", "+            rewards_engine.block_unauthorized_level_mutation_deltas,\r\n+        ):\r\n"]
[0.000, "o", "+            with self.subTest(guard=guard.__name__):\r\n"]
[0.000, "o", "+                candidate = {\r\n"]
[0.000, "o", "+                    \"player_character_data\": dict(\r\n"]
[0.000, "o", "+                        malformed_pair[\"player_character_data\"]\r\n"]
[0.000, "o", "+                    )\r\n"]
[0.000, "o", "+                }\r\n"]
[0.000, "o", "+                guard(\r\n"]
[0.000, "o", "+                    candidate,\r\n"]
[0.000, "o", "+                    original_state,\r\n"]
[0.000, "o", "+                    agent_mode=constants.MODE_CHARACTER,\r\n"]
[0.000, "o", "+                    level_up_signal=None,\r\n"]
[0.000, "o", "+                )\r\n+                self.assertEqual(\r\n"]
[0.000, "o", "+                    original_state[\"player_character_data\"][\"level\"],\r\n"]
[0.000, "o", "+                    candidate[\"player_character_data\"][\"level\"],\r\n"]
[0.000, "o", "+                )\r\n+                self.assertEqual(\r\n+                    original_state[\"player_character_data\"][\"experience\"],\r\n+                    candidate[\"player_character_data\"][\"experience\"],\r\n+                )\r\n+\r\n+    def test_pcd_grant_rejects_bool_or_malformed_experience(self):\r\n+        original_state = {\r\n+            \"player_character_data\": {\"level\": 3, \"experience\": {\"current\": 2690}}\r\n+        }\r\n+        for experience in ({\"current\": True}, [2700, 6500], \"2700\"):\r\n+            with self.subTest(experience=experience):\r\n+                updated_state = {\r\n+                    \"player_character_data\": {\r\n+                        \"level\": 4,\r\n+                        \"experience\": experience,\r\n+                    }\r\n+                }\r\n+                rewards_engine.block_unauthorized_level_mutations(\r\n+                    updated_state,\r\n+                    original_state,\r\n"]
[0.000, "o", "+                    agent_mode=constants.MODE_CHARACTER,\r\n+                    level_up_signal=None,\r\n+                )\r\n"]
[0.000, "o", "+                self.assertEqual(3, updated_state[\"player_character_data\"][\"level\"])\r\n"]
