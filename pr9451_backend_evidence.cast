[0.002, "o", "diff --git a/mvp_site/tests/test_end2end/fixtures/organic_level_up_replay/stage_01_threshold.json b/mvp_site/tests/test_end2end/fixtures/organic_level_up_replay/stage_01_threshold.json\r\ndeleted file mode 100644\r\nindex 480ca17534..0000000000\r\n"]
[0.000, "o", "--- a/mvp_site/tests/test_end2end/fixtures/organic_level_up_replay/stage_01_threshold.json\r\n+++ /dev/null\r\n@@ -1,117 +0,0 @@\r\n-{\r\n-  \"session_header\": \"[SESSION_HEADER]\\nTimestamp: 1492 DR, Mirtul 15, 12:06:00\\nLocation: Trial Chamber Alpha\\nStatus: Lvl 1 Paladin | HP: 12/12 | XP: 306/300 | Gold: 25gp\\nConditions: Normal | Exhaustion: 0 | Inspiration: No\",\r\n-  \"resources\": \"HD: 1/1, Spells: No Spells Yet (Level 2 pending), Lay on Hands: 5/5\",\r\n-  \"narrative\": \"Midday (12:06:00) in Trial Chamber Alpha—the sparring construct (Lvl 1) lunges with mechanical fury, its four arms a blur of bronze and training steel. You attempt a quick riposte, but the machine's azure eyes predict your path, and your longsword whistles through empty air as it pivots away. \\n\\nBefore it can counter, you throw your shoulder into its chassis, using your momentum to execute a powerful tactical shove. The construct's internal gyros whine in protest as its brass feet skid across the obsidian floor, leaving long, scorched streaks. Seizin"]
[0.000, "o", "g the momentary imbalance, you bring your blade down in a heavy, decisive arc. The edge bites deep into the central power core; with a final, dying hiss of steam and a spray of celestial sparks, the construct's azure glow fades to black. It slumps to the floor, a heap of silent clockwork. \\n\\n\\\"Evaluation Sequence 001 Complete,\\\" the genderless voice resonates through the chamber. \\\"Performance: Exceptional. XP awarded: 204. Candidate Mira (Lvl 1), prepare for Tier 2 synchronization.\\\"\\n\\nA pillar of shimmering white light descends from the vaulted ceiling, bathing you in the warmth of divine recognition. You feel the experiences of the gauntlet coalescing, your oath tightening and your connection to the celestial light deepening. You have surpassed your initial limits. You gain 204 XP!\",\r\n"]
[0.000, "o", "-  \"planning_block\": {\r\n-    \"thinking\": \"Mira has successfully completed her first martial evaluation. With the accelerated XP rule (34% per success), she has crossed the threshold for Level 2. According to the Level-Up Protocol, I must now present the option to level up and pause narrative progression until the modal is processed.\",\r\n-    \"context\": \"Post-combat evaluation and level-up transition.\",\r\n-    \"choices\": [\r\n-      {\r\n-        \"id\": \"level_up_now\",\r\n-        \"text\": \"Level Up to Level 2\",\r\n-        \"description\": \"Unlock Paladin Level 2 features, including Divine Smite, Fighting Style, and Spellcasting.\",\r\n-        \"risk_level\": \"safe\",\r\n-        \"freeze_time\": true\r\n-      }\r\n-    ]\r\n"]
[0.000, "o", "-  },\r\n-  \"action_resolution\": {\r\n"]
[0.000, "o", "-    \"player_input\": \"I take the next demanding gauntlet challenge and roll whatever checks or attacks are needed to complete it successfully (organic level 2 training round 2).\",\r\n-    \"interpreted_as\": \"melee_attack_and_tactical_maneuver\",\r\n"]
