[0.000, "o", "-                            \"text\": \"Finish Level-Up and Return to Game\",\r\n-                            \"description\": \"Apply choices and return to the game.\",\r\n"]
[0.000, "o", "-                            \"freeze_time\": True,\r\n-                        }\r\n"]
[0.000, "o", "-                    ],\r\n"]
[0.000, "o", "-                },\r\n"]
[0.000, "o", "-            }\r\n"]
[0.000, "o", "-        )\r\n"]
[0.000, "o", "-\r\n-    # ------------------------------------------------------------------\r\n"]
[0.000, "o", "-    # FC-1: Malformed finish — LLM omits level bump → fail closed\r\n"]
[0.000, "o", "-    # ------------------------------------------------------------------\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-    @patch(\"mvp_site.firestore_service.get_db\")\r\n"]
[0.000, "o", "-    @patch(\"mvp_site.llm_service._call_llm_api_with_llm_request\")\r\n"]
