[0.000, "o", "-            },\r\n"]
[0.000, "o", "-            headers=self.headers,\r\n"]
[0.000, "o", "-        )\r\n"]
[0.000, "o", "-        self.assertEqual(\r\n"]
[0.000, "o", "-            response.status_code,\r\n"]
[0.000, "o", "-            200,\r\n-            response.get_data(as_text=True),\r\n"]
[0.000, "o", "-        )\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-        # --- Fail-closed assertions ---\r\n"]
[0.000, "o", "-        persisted = self._game_state_ref(db, campaign_id).get().to_dict()\r\n"]
[0.000, "o", "-        persisted_level = persisted[\"player_character_data\"][\"level\"]\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-        # PRIMARY invariant: the character level must NOT have been committed\r\n"]
[0.000, "o", "-        # when the LLM omitted the level bump from state_updates.\r\n-        # This is the fail-closed contract: a finish without a model-owned\r\n"]
[0.000, "o", "-        # level field must not silently advance the character level.\r\n-        self.assertEqual(\r\n"]
[0.000, "o", "-            persisted_level,\r\n-            3,\r\n"]
[0.000, "o", "-            f\"FC-1: character level must stay at 3 when LLM omits the bump; \"\r\n"]
[0.000, "o", "-            f\"got {persisted_level}. Server committed a level without a \"\r\n"]
[0.000, "o", "-            \"model-owned level field in state_updates (fail-open).\",\r\n"]
[0.000, "o", "-        )\r\n-\r\n"]
[0.000, "o", "-    # ------------------------------------------------------------------\r\n"]
[0.000, "o", "-    # FC-2: Control — healthy finish commits the level\r\n-    # ------------------------------------------------------------------\r\n"]
[0.000, "o", "-\r\n-    @patch(\"mvp_site.firestore_service.get_db\")\r\n"]
[0.000, "o", "-    @patch(\"mvp_site.llm_service._call_llm_api_with_llm_request\")\r\n"]
[0.000, "o", "-    def test_healthy_finish_commits_level(self, mock_llm_request, mock_get_db):\r\n-        \"\"\"FC-2 (control): LLM returns well-formed finish turn with level=4.\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-        The server must commit the level to 4. This case proves the harness\r\n"]
[0.000, "o", "-        can detect the difference between a committed and a rejected finish.\r\n"]
[0.000, "o", "-        \"\"\"\r\n"]
[0.000, "o", "-        _force_real_agent_routing(self)\r\n"]
[0.000, "o", "-\r\n"]
