[0.000, "o", "-            \"campaigns\"\r\n"]
[0.000, "o", "-        ).document(campaign_id).set(\r\n"]
[0.000, "o", "-            {\r\n"]
[0.000, "o", "-                \"title\": title,\r\n"]
[0.000, "o", "-                \"setting\": \"Test Realm\",\r\n-                \"selected_prompts\": [\"narrative\", \"mechanics\"],\r\n-            }\r\n-        )\r\n-\r\n-    def _seed_level_up_in_progress_state(self, db, campaign_id):\r\n-        \"\"\"Seed game_state with level-up modal active, awaiting finish.\r\n-\r\n-        player_character_data.level=3, target_level=4 in rewards_pending.\r\n-        The planning_block presents the canonical finish choice.\r\n-        \"\"\"\r\n-        self._game_state_ref(db, campaign_id).set(\r\n-            {\r\n-                \"user_id\": self.TEST_USER_ID,\r\n-                \"story_text\": \"Power crackles at the threshold of the next level.\",\r\n-                \"player_character_data\": {\r\n-                    \"name\": \"Brienna\",\r\n-                    \"class_name\": \"Rogue\",\r\n-                    \"level\": 3,\r\n"]
[0.000, "o", "-                    \"experience\": {\"current\": 2900},\r\n-                    \"hp_max\": 24,\r\n-                },\r\n-                \"custom_campaign_state\": {\r\n-                    \"character_creation_completed\": True,\r\n-                    \"character_creation_in_progress\": False,\r\n-                    \"level_up_pending\": True,\r\n-                    \"level_up_in_progress\": True,\r\n-                    \"level_up_complete\": False,\r\n-                },\r\n-                \"rewards_pending\": {\r\n-                    \"source\": \"level_up\",\r\n-                    \"level_up_available\": True,\r\n-                    \"current_level\": 3,\r\n-                    \"target_level\": 4,\r\n-                    \"new_level\": 4,\r\n-                    \"processed\": False,\r\n-                },\r\n"]
[0.000, "o", "-                \"planning_block\": {\r\n-                    \"thinking\": \"Player is finishing level-up.\",\r\n-                    \"choices\": [\r\n-                        {\r\n"]
