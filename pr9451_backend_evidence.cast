[0.000, "o", " def test_god_mode_admin_commit_refuses_below_target_level():\r\n"]
[0.000, "o", "     \"\"\"Bug fix (Bugbot MEDIUM / CR fix-1): god-mode admin commit must enforce\r\n"]
[0.000, "o", "     the same level-guard invariant as ``complete_finish_commit`` — refuse if the\r\n"]
[0.000, "o", "@@ -273,6 +347,65 @@ def test_apply_level_up_rejects_hollow_sheet_containing_only_level():\r\n             )\r\n \r\n \r\n+def test_apply_level_up_rejects_progression_only_sheet():\r\n+    \"\"\"Level and XP alone are not a complete target-level character sheet.\"\"\"\r\n+    state = {\r\n+        \"player_character_data\": {\r\n+            \"level\": 2,\r\n+            \"experience\": {\"current\": 300},\r\n+            \"health\": {\"hp\": 18, \"hp_max\": 18},\r\n+        }\r\n"]
[0.000, "o", "+    }\r\n+\r\n+    with pytest.raises(ValueError, match=\"target-level mechanics\"):\r\n+        apply_level_up(\r\n"]
[0.000, "o", "+            state,\r\n"]
[0.000, "o", "+            level_facts={\r\n"]
[0.000, "o", "+                \"to_level\": 3,\r\n"]
[0.000, "o", "+                \"sheet\": {\"level\": 3, \"experience\": {\"current\": 900}},\r\n"]
[0.000, "o", "+            },\r\n"]
[0.000, "o", "+            source=SOURCE_MODEL,\r\n"]
[0.000, "o", "+        )\r\n"]
[0.000, "o", "+\r\n"]
