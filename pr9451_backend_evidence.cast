[0.000, "o", "-        self, mock_gemini_request, mock_get_db\r\n"]
[0.000, "o", "-    ):\r\n-        \"\"\"Path B (conclude prompt): on the finish turn the MODEL authors the\r\n"]
[0.000, "o", "-        canonical ``state_updates.player_character_data.level`` and the backend\r\n"]
[0.000, "o", "-        persists exactly that — no XP/rewards_pending override.\r\n"]
[0.000, "o", "-\r\n-        The backend override (``commit_expected_level_from_xp``) was removed, so\r\n"]
[0.000, "o", "-        the model-emitted level is the sole commit path.\r\n-        \"\"\"\r\n"]
[0.000, "o", "-        _disable_mock_services_mode(self)\r\n-        db = FakeFirestoreClient()\r\n"]
