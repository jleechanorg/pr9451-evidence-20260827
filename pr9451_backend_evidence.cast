[0.000, "o", "+        expectation.assert_matches(\r\n"]
[0.000, "o", "+            {\r\n"]
[0.000, "o", "+                \"game_mode\": \"character\",\r\n"]
[0.000, "o", "+                \"game_state\": {\"player_character_data\": {\"level\": 2}},\r\n"]
[0.000, "o", "+                \"story_history\": [\r\n"]
