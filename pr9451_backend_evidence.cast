[0.000, "o", " \r\n+def collect_raw_progression_contract_errors(\r\n+    *, raw_response_text: str | None, context: str\r\n"]
[0.000, "o", "+) -> list[str]:\r\n"]
[0.000, "o", "+    \"\"\"Reject model-owned XP/progression surfaces outside canonical PCD.\r\n"]
[0.000, "o", "+\r\n"]
[0.000, "o", "+    The only permitted numeric progression values are\r\n"]
[0.000, "o", "+    ``state_updates.player_character_data.experience.current`` and the paired\r\n+    ``state_updates.player_character_data.level``. Numeric XP text is forbidden\r\n"]
[0.000, "o", "+    everywhere except the persisted directive policy, which may contain a\r\n"]
[0.000, "o", "+    percentage or pacing rule. This is deliberately an\r\n"]
[0.000, "o", "+    evidence-run assertion over exact JSON paths, not production routing or\r\n+    response repair.  The two text fields are additionally checked for an\r\n"]
[0.000, "o", "+    explicit numeric XP/experience mention because those values otherwise\r\n"]
[0.000, "o", "+    evade a structured-key-only audit.\r\n"]
[0.000, "o", "+    \"\"\"\r\n"]
[0.000, "o", "+    if not isinstance(raw_response_text, str) or not raw_response_text.strip():\r\n+        return []\r\n"]
[0.000, "o", "+    try:\r\n"]
[0.000, "o", "+        parsed = json.loads(raw_response_text)\r\n"]
[0.000, "o", "+    except json.JSONDecodeError:\r\n"]
[0.000, "o", "+        parsed = extract_raw_story_payload(raw_response_text)\r\n+    if not isinstance(parsed, dict):\r\n"]
[0.000, "o", "+        return []\r\n"]
[0.000, "o", "+\r\n"]
[0.000, "o", "+    errors: list[str] = []\r\n"]
[0.000, "o", "+\r\n"]
[0.000, "o", "+    def path_text(path: tuple[str, ...]) -> str:\r\n"]
[0.000, "o", "+        return \".\".join(path)\r\n+\r\n"]
[0.000, "o", "+    def is_number(value: Any) -> bool:\r\n"]
[0.000, "o", "+        if isinstance(value, bool) or value is None:\r\n"]
[0.000, "o", "+            return False\r\n+        if isinstance(value, (int, float)):\r\n"]
[0.000, "o", "+            return True\r\n"]
[0.000, "o", "+        if isinstance(value, str):\r\n"]
[0.000, "o", "+            try:\r\n"]
[0.000, "o", "+                float(value.replace(\",\", \"\").strip())\r\n"]
[0.000, "o", "+            except (TypeError, ValueError):\r\n+                return False\r\n"]
[0.000, "o", "+            return bool(value.strip())\r\n"]
[0.000, "o", "+        return False\r\n"]
[0.000, "o", "+\r\n"]
[0.000, "o", "+    def walk(value: Any, path: tuple[str, ...]) -> None:\r\n"]
[0.000, "o", "+        if isinstance(value, dict):\r\n"]
[0.000, "o", "+            for key, child in value.items():\r\n"]
[0.000, "o", "+                if not isinstance(key, str):\r\n+                    continue\r\n"]
[0.000, "o", "+                child_path = (*path, key)\r\n"]
[0.000, "o", "+                if key == \"session_header\":\r\n"]
[0.000, "o", "+                    errors.append(\r\n"]
[0.000, "o", "+                        f\"{context}: raw model emitted forbidden {path_text(child_path)}\"\r\n"]
[0.000, "o", "+                    )\r\n"]
[0.000, "o", "+                elif key in _FORBIDDEN_PROGRESSION_OBJECT_KEYS:\r\n"]
[0.000, "o", "+                    errors.append(\r\n"]
[0.000, "o", "+                        f\"{context}: raw model emitted forbidden progression field \"\r\n"]
[0.000, "o", "+                        f\"{path_text(child_path)}\"\r\n"]
[0.000, "o", "+                    )\r\n"]
[0.000, "o", "+                elif key in _FORBIDDEN_PROGRESSION_KEYS:\r\n"]
[0.000, "o", "+                    errors.append(\r\n"]
[0.000, "o", "+                        f\"{context}: raw model emitted forbidden progression field \"\r\n+                        f\"{path_text(child_path)}; canonical XP belongs only at \"\r\n"]
[0.000, "o", "+                        \"state_updates.player_character_data.experience.current\"\r\n"]
[0.000, "o", "+                    )\r\n"]
[0.000, "o", "+                elif (\r\n"]
[0.000, "o", "+                    key == \"current\"\r\n+                    and is_number(child)\r\n"]
[0.000, "o", "+                    and len(child_path) >= 2\r\n"]
[0.000, "o", "+                    and child_path[-2] == \"experience\"\r\n"]
[0.000, "o", "+                ):\r\n"]
[0.000, "o", "+                    if child_path != _ALLOWED_XP_PATH:\r\n"]
[0.000, "o", "+                        errors.append(\r\n+                            f\"{context}: raw model emitted numeric current at \"\r\n"]
[0.000, "o", "+                            f\"{path_text(child_path)}; canonical XP belongs only at \"\r\n"]
[0.000, "o", "+                            \"state_updates.player_character_data.experience.current\"\r\n"]
[0.000, "o", "+                        )\r\n"]
[0.000, "o", "+                elif key == \"level\" and is_number(child):\r\n"]
[0.000, "o", "+                    progression_context = (\r\n"]
[0.000, "o", "+                        \"player_character_data\" in child_path\r\n"]
[0.000, "o", "+                        or child_path[0] in {\"rewards_box\", \"level_up_signal\"}\r\n"]
[0.000, "o", "+                    )\r\n+                    if progression_context and child_path != _ALLOWED_LEVEL_PATH:\r\n"]
[0.000, "o", "+                        errors.append(\r\n"]
[0.000, "o", "+                            f\"{context}: raw model emitted numeric level at \"\r\n"]
[0.000, "o", "+                            f\"{path_text(child_path)}; paired level belongs only at \"\r\n"]
[0.000, "o", "+                            \"state_updates.player_character_data.level\"\r\n"]
[0.000, "o", "+                        )\r\n"]
[0.000, "o", "+                walk(child, child_path)\r\n"]
[0.000, "o", "+            return\r\n"]
[0.000, "o", "+        if not isinstance(value, str) or not path:\r\n"]
[0.000, "o", "+            return\r\n+        if path[0] != \"directives\" and _NUMERIC_XP_MENTION_RE.search(value):\r\n"]
[0.000, "o", "+            errors.append(\r\n"]
[0.000, "o", "+                f\"{context}: raw model emitted numeric XP/experience in \"\r\n"]
[0.000, "o", "+                f\"{path_text(path)}\"\r\n"]
[0.000, "o", "+            )\r\n+\r\n"]
[0.000, "o", "+    walk(parsed, ())\r\n"]
[0.000, "o", "+    return errors\r\n"]
[0.000, "o", "+\r\n"]
[0.000, "o", "+\r\n"]
[0.000, "o", " \r\n"]
[0.000, "o", " def extract_raw_story_payload(raw_response_text: str | None) -> dict[str, Any] | None:\r\n"]
[0.000, "o", "     \"\"\"Return the best-effort JSON object from raw LLM output.\"\"\"\r\n"]
[0.002, "o", "diff --git a/testing_mcp/lib/server_utils.py b/testing_mcp/lib/server_utils.py\r\nindex 4f3c406726..d2a911cc89 100644\r\n--- a/testing_mcp/lib/server_utils.py\r\n+++ b/testing_mcp/lib/server_utils.py\r\n@@ -37,6 +37,19 @@ WORLDARCH_VENV = (\r\n )\r\n WORLDARCH_LOCAL_VENV = PROJECT_ROOT / \"venv\" / \"bin\" / \"python\"\r\n \r\n+\r\n+def _local_checkout_head_sha() -> str:\r\n+    \"\"\"Return the exact checkout SHA injected into the local server health response.\"\"\"\r\n+    result = subprocess.run(\r\n+        [\"git\", \"rev-parse\", \"HEAD\"],\r\n+        cwd=str(PROJECT_ROOT),\r\n+        check=True,\r\n+        capture_output=True,\r\n+        text=True,\r\n+        timeout=10,\r\n+    )\r\n+    return result.stdout.strip()\r\n+\r\n # Critical imports the gunicorn worker must be able to load before the server\r\n # will accept a single request. If a candidate python_bin is missing any of\r\n # these, we reject it rather than let gunicorn crash with a cryptic worker\r\n@@ -822,6 +835,8 @@ def start_local_mcp_server(\r\n     if env_overrides:\r\n         env.update(env_overr"]
[0.000, "o", "ides)\r\n"]
[0.000, "o", " \r\n+    env[\"GIT_COMMIT\"] = _local_checkout_head_sha()\r\n+\r\n     _apply_local_test_provider_defaults(env)\r\n \r\n     # After .env + overrides are merged into env, reject mock flags (dotenv-only values count).\r\n"]
