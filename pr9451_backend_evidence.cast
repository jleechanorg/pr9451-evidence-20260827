[0.000, "o", "+def test_repeated_pcd_canonicalization_preserves_committing_session():\r\n"]
[0.000, "o", "+    \"\"\"Replaying the same response cannot reopen or replace a committing session.\"\"\"\r\n"]
[0.000, "o", "+    authored_sheet = {\r\n"]
[0.000, "o", "+        \"level\": 4,\r\n"]
[0.000, "o", "+        \"health\": {\"hp\": 27, \"hp_max\": 27},\r\n"]
[0.000, "o", "+        \"experience\": {\"current\": 2790, \"to_next_level\": 6500},\r\n"]
[0.000, "o", "+    }\r\n"]
[0.000, "o", "+    committing_session = {\r\n"]
[0.000, "o", "+        \"status\": STATUS_COMMITTING,\r\n"]
[0.000, "o", "+        \"current_level\": 4,\r\n"]
[0.000, "o", "+        \"target_level\": 4,\r\n"]
[0.000, "o", "+        \"from_level\": 3,\r\n"]
[0.000, "o", "+        \"to_level\": 4,\r\n+        \"applied\": copy.deepcopy(authored_sheet),\r\n"]
[0.000, "o", "+        \"offered_choices\": {\"asi\": [\"wisdom\"]},\r\n"]
[0.000, "o", "+        \"selections\": {\"asi\": \"wisdom\"},\r\n"]
[0.000, "o", "+        \"source\": \"model\",\r\n"]
[0.000, "o", "+        \"review_open\": True,\r\n"]
[0.000, "o", "+        \"modal_open\": True,\r\n"]
[0.000, "o", "+    }\r\n+    state = {\r\n+        \"player_character_data\": copy.deepcopy(authored_sheet),\r\n+        \"level_up_session\": copy.deepcopy(committing_session),\r\n+    }\r\n+    original_state = {\r\n+        \"player_character_data\": {\r\n+            \"level\": 3,\r\n+            \"experience\": {\"current\": 2690, \"to_next_level\": 3810},\r\n+        }\r\n+    }\r\n+    structured_fields = {\r\n"]
[0.000, "o", "+        \"state_updates\": {\"player_character_data\": copy.deepcopy(authored_sheet)}\r\n"]
[0.000, "o", "+    }\r\n"]
[0.000, "o", "+\r\n"]
[0.000, "o", "+    rewards_engine.canonicalize_rewards(structured_fields, state, original_state)\r\n+\r\n"]
[0.000, "o", "+    assert state[\"level_up_session\"] == committing_session\r\n"]
