[0.000, "o", "-                    \"level_up_complete\": False,\r\n"]
[0.000, "o", "-                },\r\n"]
[0.000, "o", "-                \"level_up_session\": {\r\n-                    \"status\": \"in_progress\",\r\n"]
[0.000, "o", "-                    \"current_level\": 3,\r\n"]
[0.000, "o", "-                    \"target_level\": 4,\r\n-                    # v2 contract: apply_level_up() always sets review_open=True\r\n"]
[0.000, "o", "-                    # for an in-modal session; the finish click fires while the\r\n"]
