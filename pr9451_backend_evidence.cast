[0.000, "o", "-                # v2 routing authority: an OPEN in_progress modal carries\r\n-                # review_open=True. The stale-legacy-flag tests rely solely on\r\n-                # the canonical session to route, so it must be route-active.\r\n"]
[0.000, "o", "-                \"review_open\": True,\r\n"]
