[0.000, "o", "normalized\r\n+\r\n+\r\n+def test_amend_contract_writes_complete_pcd_and_preserves_state():\r\n+    \"\"\"Every amendment immediately authors a complete, preserved PCD sheet.\"\"\"\r\n+    for filename in (\"level_up_instruction.md\", \"level_up_modal_override_instruction.md\"):\r\n+        text = _load(filename)\r\n+        normalized = \" \".join(text.split())\r\n+        lower = normalized.lower()\r\n+\r\n+        assert \"complete amended `state_updates.player_character_data`\" in normalized\r\n+        assert \"preserv\" in lower\r\n+        assert \"experience.current\" in normalized\r\n+        assert \"selected mechanics\" in lower\r\n+        assert \"keep the review open\" in lower or \"keep the review menu open\" in lower\r\n+\r\n+\r\n+def test_finish_contract_does_not_author_pcd_or_mechanics():\r\n"]
