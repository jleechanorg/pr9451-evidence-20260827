[0.003, "o", "diff --git a/mvp_site/tests/fake_llm_realistic.py b/mvp_site/tests/fake_llm_realistic.py\r\nindex c10e64d4e9..5e81cf3c7c 100644\r\n--- a/mvp_site/tests/fake_llm_realistic.py\r\n+++ b/mvp_site/tests/fake_llm_realistic.py\r\n@@ -29,6 +29,9 @@ The narrative and planning_block keys are from the real production schema.\r\n from __future__ import annotations\r\n \r\n import json\r\n+from dataclasses import dataclass\r\n+from pathlib import Path\r\n+from typing import Any\r\n \r\n \r\n # ---------------------------------------------------------------------------\r\n@@ -167,6 +170,82 @@ class RealisticFakeLLMResponse:\r\n         return self.text\r\n \r\n \r\n+def _json_path_values(payload: Any, dotted_path: str) -> list[Any]:\r\n+    \"\"\"Resolve a dotted path, with ``*`` matching every list or dict value.\"\"\"\r\n+    values = [payload]\r\n"]
[0.000, "o", "+    for part in dotted_path.split(\".\"):\r\n+        next_values: list[Any] = []\r\n+        for current in values:\r\n+            if part == \"*\":\r\n+                if isinstance(current, list):\r\n+                    next_values.extend(current)\r\n+                elif isinstance(current, dict):\r\n"]
[0.000, "o", "+                    next_values.extend(current.values())\r\n"]
[0.000, "o", "+                continue\r\n+            if isinstance(current, dict) and part in current:\r\n"]
[0.000, "o", "+                next_values.append(current[part])\r\n+        values = next_values\r\n"]
[0.000, "o", "+        if not values:\r\n"]
[0.000, "o", "+            break\r\n"]
[0.000, "o", "+    return values\r\n"]
[0.000, "o", "+\r\n"]
