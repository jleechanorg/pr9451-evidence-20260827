[0.000, "o", "-        self._game_state_ref(db, campaign_id).set(\r\n-            {\r\n"]
[0.000, "o", "-                \"user_id\": self.TEST_USER_ID,\r\n-                \"story_text\": \"The hush before the new mantle.\",\r\n"]
[0.000, "o", "-                \"player_character_data\": {\r\n"]
[0.000, "o", "-                    \"name\": \"Arion\",\r\n"]
[0.000, "o", "-                    \"class_name\": \"Fighter\",\r\n"]
[0.000, "o", "-                    \"level\": 3,\r\n"]
[0.000, "o", "-                    \"experience\": {\"current\": 2802},\r\n"]
[0.000, "o", "-                    \"hp_max\": 28,\r\n-                },\r\n"]
