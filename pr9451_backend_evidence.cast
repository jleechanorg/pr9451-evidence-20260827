[0.000, "o", "-        mock_get_db.return_value = db\r\n"]
[0.000, "o", "-        campaign_id = \"test-finish-control-healthy\"\r\n"]
[0.000, "o", "-        self._seed_campaign_doc(db, campaign_id, \"Control Healthy Finish Test\")\r\n"]
[0.000, "o", "-        self._seed_level_up_in_progress_state(db, campaign_id)\r\n-\r\n-        # LLM returns the finish turn with the canonical level bump.\r\n-        mock_llm_request.return_value = FakeLLMResponse(\r\n-            json.dumps(\r\n-                {\r\n-                    \"narrative\": (\r\n-                        \"The power settles. You have become stronger — Level 4 attained.\"\r\n-                    ),\r\n-                    \"state_updates\": {\r\n-                        \"player_character_data\": {\r\n-                            \"level\": 4,\r\n-                            \"hp_max\": 32,\r\n-                        },\r\n-                        \"custom_campaign_state\": {\r\n-                            \"level_up_pending\": False,\r\n-                            \"level_up_in_progress\": False,\r\n-                            \"level_up_complete\": True,\r\n-                        },\r\n-                    },\r\n-                    \"planning_block\": {\r\n-                        \"thinking\": \"Level-up committed. Returning to game.\",\r\n-          "]
[0.000, "o", "              \"choices\": [\r\n-                            {\r\n-                                \"id\": \"continue_story\",\r\n-                                \"text\": \"Continue\",\r\n-                                \"description\": \"Continue the adventure.\",\r\n-                            }\r\n-                        ],\r\n-                    },\r\n-                }\r\n-            )\r\n-        )\r\n-\r\n-        response = self.client.post(\r\n-            f\"/api/campaigns/{campaign_id}/interaction\",\r\n-            json={\r\n-                \"input\": \"CHOICE:finish_level_up_return_to_game\",\r\n-                \"mode\": \"character\",\r\n-            },\r\n-            headers=self.headers,\r\n-        )\r\n-        self.assertEqual(\r\n-            response.status_code,\r\n-            200,\r\n-            response.get_data(as_text=True),\r\n-        )\r\n-\r\n-        # --- Control assertions: level must be committed to 4 ---\r\n-        persisted = self._game_state_ref(db, campaign_id).get().to_dict()\r\n-        persisted_level = persisted[\"player_character_dat"]
[0.000, "o", "a\"][\"level\"]\r\n-        custom_state = persisted.get(\"custom_campaign_state\", {})\r\n-\r\n-        self.assertEqual(\r\n-            persisted_level,\r\n-            4,\r\n-            f\"FC-2: healthy finish must commit level to 4; got {persisted_level}\",\r\n-        )\r\n-        self.assertTrue(\r\n-            custom_state.get(\"level_up_complete\"),\r\n-            \"FC-2: healthy finish must set level_up_complete=True\",\r\n-        )\r\n-        self.assertFalse(\r\n-            custom_state.get(\"level_up_in_progress\"),\r\n-            \"FC-2: healthy finish must clear level_up_in_progress\",\r\n-        )\r\n-\r\n-        # Rewards integrity: if rewards_pending is retained it must be processed.\r\n-        rewards_pending = persisted.get(\"rewards_pending\")\r\n-        if rewards_pending is not None:\r\n-            self.assertIs(\r\n-                rewards_pending.get(\"processed\"),\r\n"]
[0.000, "o", "-                True,\r\n-                \"FC-2: rewards_pending.processed must be True after healthy finish\",\r\n"]
