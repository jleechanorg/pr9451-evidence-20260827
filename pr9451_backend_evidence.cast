[0.000, "o", "-    ],\r\n"]
[0.000, "o", "-    \"narrative_outcome\": \"The Gauntlet's barrier prevents progress until the Level 2 synchronization is completed.\"\r\n-  },\r\n"]
[0.000, "o", "-  \"level_up_signal\": {\r\n"]
[0.000, "o", "-    \"current_level\": 1,\r\n"]
[0.000, "o", "-    \"target_level\": 2\r\n"]
[0.000, "o", "-  },\r\n"]
