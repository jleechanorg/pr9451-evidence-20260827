[0.000, "o", "+            \"level\": 3,\r\n"]
[0.000, "o", "+            \"experience\": {\"current\": 2690, \"to_next_level\": 3810},\r\n"]
[0.000, "o", "+        }\r\n"]
[0.000, "o", "+    }\r\n"]
[0.000, "o", "+    state = copy.deepcopy(original_state)\r\n"]
[0.000, "o", "+    structured_fields = {\r\n"]
