[0.002, "o", "diff --git a/mvp_site/tests/test_canonicalize_invariants.py b/mvp_site/tests/test_canonicalize_invariants.py\r\nindex 5659b57e13..8a31477c43 100644\r\n--- a/mvp_site/tests/test_canonicalize_invariants.py\r\n+++ b/mvp_site/tests/test_canonicalize_invariants.py\r\n@@ -1494,153 +1494,6 @@ class TestSealedGrantRawBoxNotDiscardedForMalformedLegacySignal(unittest.TestCas\r\n         self.assertEqual(rb.get(\"next_level_xp\"), 23000)\r\n \r\n \r\n-class TestCanonicalXpSyncedToPlayerCharacterData(unittest.TestCase):\r\n"]
[0.000, "o", "-    \"\"\"rev-px6ra: canonicalize_rewards's canonical rewards_box.current_xp\r\n-    must be synced back into player_character_data.experience.current, not\r\n-    just left in game_state_dict[\"rewards_box\"] for display.\r\n-\r\n-    session_header_utils._resolve_xp_pair (the function that builds the\r\n-    session-header XP line) reads player_character_data.experience.current,\r\n-    NOT rewards_box.current_xp. Real evidence (3 separate live turns, 3\r\n-    different characters/campaigns): rewards_box.current_xp correctly\r\n"]
[0.000, "o", "-    showed 900 / 6500 / 50, but the session header always rendered\r\n-    \"XP: 0/300\" -- the level-1 default -- because nothing wrote the\r\n"]
[0.000, "o", "-    rewards_box value back into player_character_data.\r\n-    \"\"\"\r\n"]
[0.000, "o", "-\r\n-    @unittest.expectedFailure  # noqa: PT015 - see reason below\r\n"]
[0.000, "o", "-    # xfail reason: \"rev-px6ra is deliberately not provided on ordinary XP-gain turns. On such a turn game_state.ensure_level_up_rewards_pending writes NO rewards_pending (verified), so there is no per-turn award provenance, and the state is identical to a duplicate award. Trusting the model total there writes an inflated XP into player_character_data.experience.current via _sync_player_character_xp_from_canonical_rewards_box, whose guard only blocks decreases -- permanent corruption. The layer-correct fix is rev-5i6ug (make the model emit experience.current so no inference is needed).\"\r\n"]
[0.000, "o", "-    def test_xp_progress_without_level_up_syncs_experience_current(self):\r\n-        # game_state_dict/original_state_dict represent the STALE persisted\r\n"]
[0.000, "o", "-        # XP (300) from before this turn's award; the model's rewards_box\r\n-        # reports the correct NEW total (900) after a 600-XP gain.\r\n-        game_state_dict = _game_state(level=5, xp=300)\r\n-        original_state_dict = _game_state(level=5, xp=300)\r\n-        structured_fields = {\r\n-            \"rewards_box\": {\r\n-                \"level_up_available\": False,\r\n-                \"current_level\": 5,\r\n-                \"xp_gained\": 600,\r\n-                \"current_xp\": 900,\r\n-                \"next_level_xp\": 2700,\r\n-                \"gold\": 0,\r\n-                \"loot\": [],\r\n-                \"progress_percent\": 33.3,\r\n-            },\r\n-        }\r\n-\r\n-        rb, _pb = rewards_engine.canonicalize_rewards(\r\n-            structured_fields, game_state_dict, original_state_dict\r\n-        )\r\n-\r\n-        self.assertIsNotNone(rb)\r\n-        self.assertEqual(rb.get(\"current_xp\"), 900)\r\n-        self.assertEqual(\r\n-            game_state_dict[\"player_character_data\"][\"experience\"][\"current\"],\r\n-            900,\r\n-    "]
[0.001, "o", "        \"canonical rewards_box.current_xp must be synced into \"\r\n-            \"player_character_data.experience.current -- the field \"\r\n-            \"session_header_utils._resolve_xp_pair actually reads to build \"\r\n-            \"the session-header XP line\",\r\n-        )\r\n-\r\n-    def test_no_rewards_box_leaves_player_character_data_untouched(self):\r\n-        \"\"\"A turn with no XP change (no rewards_box at all) must not\r\n-        clobber the existing persisted XP with anything.\"\"\"\r\n-        game_state_dict = _game_state(level=3, xp=1200)\r\n-        original_state_dict = _game_state(level=3, xp=1200)\r\n-        structured_fields: dict[str, Any] = {}\r\n-\r\n-        rewards_engine.canonicalize_rewards(\r\n-            structured_fields, game_state_dict, original_state_dict\r\n-        )\r\n-\r\n-        self.assertEqual(\r\n-            game_state_dict[\"player_character_data\"][\"experience\"][\"current\"],\r\n-            1200,\r\n-        )\r\n-\r\n-    def test_lower_canonical_xp_does_not_regress_persisted_value(self):\r\n-        \"\"\"rev-px6"]
[0.000, "o", "ra follow-up (cold review finding): a rewards_box reporting\r\n"]
[0.000, "o", "-        a LOWER current_xp than what is already persisted must not silently\r\n"]
[0.000, "o", "-        overwrite the persisted value downward. Distinguishes stale/malformed\r\n"]
[0.000, "o", "-        rewards_box data from a legitimate turn's XP gain.\r\n-\r\n"]
[0.000, "o", "-        Scope note: this pins the composed ``canonicalize_rewards`` path, NOT\r\n-        the monotonic guard in\r\n-        ``_sync_player_character_xp_from_canonical_rewards_box``. With this\r\n-        input (``xp_gained: 0``) the visibility gate returns no rewards box, so\r\n-        the sync helper is never called and its guard is never exercised here.\r\n-        The guard itself is covered directly by\r\n-        ``test_sync_helper_blocks_downward_clobber`` below.\r\n-        \"\"\"\r\n-        game_state_dict = _game_state(level=5, xp=5000)\r\n-        original_state_dict = _game_state(level=5, xp=5000)\r\n-        structured_fields = {\r\n-            \"rewards_box\": {\r\n-                \"level_up_available\": False,\r\n-                \"current_level\": 5,\r\n-                \"xp_gained\": 0,\r\n-                \"current_xp\": 100,  # implausibly lower than the persisted 5000\r\n-                \"next_level_xp\": 14000,\r\n-                \"gold\": 0,\r\n-                \"loot\": [],\r\n-                \"progress_percent\": 0.7,\r\n-            },\r"]
