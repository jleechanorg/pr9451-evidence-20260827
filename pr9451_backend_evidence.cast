[0.000, "o", "-        # Team-lead's poll-path theory (2026-07-30): the SSE done event and\r\n-        # the immediate post-write Firestore read above are both correct,\r\n"]
[0.000, "o", "-        # matching the earlier L2 non-repro finding -- but every T11/organic\r\n"]
[0.000, "o", "-        # flow polls the campaign state AFTER the streaming write via\r\n-        # get_campaign_state_unified, which runs _prepare_game_state's\r\n"]
[0.000, "o", "-        # cleanup/sanitization machinery and can write back to Firestore\r\n"]
[0.000, "o", "-        # if was_cleaned=True. Call the REAL poll path against the SAME\r\n"]
[0.000, "o", "-        # FakeFirestore, then RE-READ the persisted document (not the\r\n"]
[0.000, "o", "-        # poll's own response) to see whether the poll corrupts the\r\n"]
[0.000, "o", "-        # already-correct persisted state.\r\n"]
[0.000, "o", "-        #\r\n-        # story_limit is REQUIRED here, not optional: main.py's real GET\r\n"]
[0.000, "o", "-        # /api/campaigns/<id> route (the one every real client -- T11,\r\n"]
[0.000, "o", "-        # organic, the frontend -- actually polls through) always passes\r\n"]
[0.000, "o", "-        # story_limit (default 300, clamped 10-500), which routes into\r\n"]
[0.000, "o", "-        # get_campaign_state_unified's PAGE-LOAD branch\r\n"]
[0.000, "o", "-        # (_fetch_campaign_state_for_page_load), a DIFFERENT code path from\r\n"]
[0.000, "o", "-        # the plain non-paginated branch. That page-load branch is the one\r\n"]
[0.000, "o", "-        # whose own docstring calls out \"modal-finish-block sync-back\" --\r\n"]
[0.000, "o", "-        # omitting story_limit here would silently test the wrong branch.\r\n"]
[0.000, "o", "-        poll_request = {\r\n-            \"user_id\": self.TEST_USER_ID,\r\n"]
[0.000, "o", "-            \"campaign_id\": campaign_id,\r\n"]
[0.000, "o", "-            \"story_limit\": 300,\r\n"]
[0.000, "o", "-            \"include_story\": True,\r\n"]
[0.000, "o", "-        }\r\n-        poll_result = asyncio.run(\r\n"]
[0.000, "o", "-            main.world_logic.get_campaign_state_unified(poll_request)\r\n"]
[0.000, "o", "-        )\r\n"]
[0.000, "o", "-        self.assertNotIn(\r\n"]
[0.000, "o", "-            \"error\",\r\n-            poll_result,\r\n"]
[0.000, "o", "-            f\"poll path must not error: {poll_result.get('error')}\",\r\n"]
[0.000, "o", "-        )\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-        # The client-facing delivery mechanism for page-load-mode polls\r\n"]
[0.000, "o", "-        # (world_logic.py:11060-11064) is the TOP-LEVEL result[\"rewards_box\"]\r\n"]
[0.000, "o", "-        # / result[\"planning_block\"] pair, NOT result[\"game_state\"]\r\n"]
[0.000, "o", "-        # (whose own rewards_box is unconditionally stripped by\r\n"]
[0.000, "o", "-        # rewards_engine.sanitize_rewards_state_for_context -- by design,\r\n"]
[0.000, "o", "-        # for LLM-context stale-echo prevention, not a bug: confirmed via\r\n-        # inspection this is intentional and separate from the client\r\n"]
[0.000, "o", "-        # delivery path). This is what a real client (T11, organic,\r\n"]
[0.000, "o", "-        # frontend) actually reads.\r\n"]
[0.000, "o", "-        poll_rewards_box = poll_result.get(\"rewards_box\") or {}\r\n"]
[0.000, "o", "-        self.assertTrue(\r\n"]
[0.000, "o", "-            poll_rewards_box.get(\"level_up_available\"),\r\n"]
[0.000, "o", "-            \"L2 POLL-PATH REPRO CHECK: the poll response's top-level \"\r\n-            \"rewards_box.level_up_available must be true -- if this is \"\r\n"]
[0.000, "o", "-            \"False/missing here, the poll-path response-assembly is the \"\r\n"]
[0.000, "o", "-            f\"persist-divergence mechanism (rev-5zt5l/rev-qqd0v). Got \"\r\n"]
[0.000, "o", "-            f\"poll rewards_box={poll_rewards_box!r}\",\r\n"]
[0.000, "o", "-        )\r\n"]
[0.000, "o", "-        poll_planning_block = poll_result.get(\"planning_block\") or {}\r\n"]
[0.000, "o", "-        poll_choice_ids = {\r\n"]
[0.000, "o", "-            c.get(\"id\")\r\n-            for c in (poll_planning_block.get(\"choices\") or [])\r\n"]
[0.000, "o", "-            if isinstance(c, dict)\r\n"]
[0.000, "o", "-        }\r\n"]
[0.000, "o", "-        self.assertIn(\r\n"]
[0.000, "o", "-            \"level_up_review\",\r\n"]
[0.000, "o", "-            poll_choice_ids,\r\n-            \"L2 POLL-PATH REPRO CHECK (rewards_engine.planning_has_level_up_choices \"\r\n"]
[0.000, "o", "-            \"false-negative on level_up_review -- confirmed live, not synthetic): \"\r\n"]
[0.000, "o", "-            \"the poll response's top-level planning_block.choices must still \"\r\n"]
[0.000, "o", "-            \"carry level_up_review -- an empty-but-non-None planning_block \"\r\n"]
[0.000, "o", "-            \"IS the rev-5zt5l 'box without choices' symptom and would pass \"\r\n"]
[0.000, "o", "-            \"a bare assertIsNotNone check. Got choice ids=\"\r\n"]
[0.000, "o", "-            f\"{poll_choice_ids!r}\",\r\n"]
[0.000, "o", "-        )\r\n"]
[0.000, "o", "-        self.assertIsNotNone(\r\n-            poll_result.get(\"planning_block\"),\r\n"]
[0.000, "o", "-            \"L2 POLL-PATH REPRO CHECK: the poll response's top-level \"\r\n"]
[0.000, "o", "-            \"planning_block must be present.\",\r\n"]
[0.000, "o", "-        )\r\n-\r\n-        state_after_poll = self._game_state_ref(db, campaign_id).get().to_dict()\r\n"]
[0.000, "o", "-        box_after_poll = state_after_poll.get(\"rewards_box\") or {}\r\n"]
[0.000, "o", "-        planning_block_after_poll = state_after_poll.get(\"planning_block\") or {}\r\n"]
[0.000, "o", "-        choice_ids_after_poll = {\r\n-            c.get(\"id\")\r\n"]
[0.000, "o", "-            for c in (planning_block_after_poll.get(\"choices\") or [])\r\n"]
[0.000, "o", "-            if isinstance(c, dict)\r\n-        }\r\n"]
[0.000, "o", "-        self.assertTrue(\r\n"]
[0.000, "o", "-            box_after_poll.get(\"level_up_available\"),\r\n-            \"L2 POLL-PATH REPRO CHECK: rewards_box.level_up_available must \"\r\n"]
[0.000, "o", "-            \"still be true in the PERSISTED document after a poll -- if \"\r\n"]
[0.000, "o", "-            \"this is False/missing here (while the pre-poll read above \"\r\n-            \"passed), the poll path's write-back is the persist-divergence \"\r\n"]
[0.000, "o", "-            f\"mechanism (rev-5zt5l/rev-qqd0v). Got rewards_box={box_after_poll!r}\",\r\n"]
[0.000, "o", "-        )\r\n"]
[0.000, "o", "-        self.assertEqual(\r\n"]
[0.000, "o", "-            choice_ids_after_poll,\r\n"]
[0.000, "o", "-            {\"continue_story\", \"level_up_review\"},\r\n"]
[0.000, "o", "-            \"L2 POLL-PATH REPRO CHECK: planning_block.choices must survive \"\r\n-            \"a poll unchanged in the persisted document -- if this is \"\r\n"]
[0.000, "o", "-            \"empty/different here (while the pre-poll read above passed), \"\r\n"]
[0.000, "o", "-            \"the poll path's write-back is the persist-divergence \"\r\n"]
[0.000, "o", "-            f\"mechanism. Got choice ids={choice_ids_after_poll!r}\",\r\n"]
[0.000, "o", "-        )\r\n"]
[0.001, "o", "diff --git a/mvp_site/tests/test_end2end/test_level_up_modal_exit_end2end.py b/mvp_site/tests/test_end2end/test_level_up_modal_exit_end2end.py\r\ndeleted file mode 100644\r\nindex 0836300bb9..0000000000\r\n--- a/mvp_site/tests/test_end2end/test_level_up_modal_exit_end2end.py\r\n+++ /dev/null\r\n@@ -1,1291 +0,0 @@\r\n-\"\"\"\r\n-End-to-end tests for the canonical level-up modal exit contract (PR #7064).\r\n-\r\n-Locks three claims through the full HTTP+Agent stack with FakeFirestoreClient\r\n-and a mocked low-level LLM call:\r\n-\r\n-  1.1 B2/F1 — Clicking the canonical `finish_level_up_return_to_game`\r\n-              choice commits the level recorded in `rewards_pending.target_level`\r\n-              even when the LLM omits the `level` field in `state_updates`.\r\n-\r\n-  1.2 B1/B3 — Legacy finish ids (`finish`, `complete_levelup`) submitted via\r\n-              `CHOICE:<id>` do NOT exit the modal or commit the level. The\r\n-              canonical finish remains available in the response.\r\n-\r\n-  1.3 B4/F3 — After a canonical finish com"]
[0.000, "o", "pletes the level-up\r\n"]
[0.000, "o", "-              (`level_up_complete=True`), a follow-up routine narrative turn\r\n-              that hallucinates `level_up_pending=True` in `state_updates`\r\n-              must NOT re-open the modal. The canonical-evidence-first guard\r\n-              suppresses the hallucinated re-entry.\r\n-\r\n-Pattern mirrors `test_modal_integration_end2end.py`:\r\n-  - FakeFirestoreClient seeded via `_game_state_ref(db, campaign_id).set(...)`\r\n-  - LLM patched at `mvp_site.llm_service._call_llm_api_with_llm_request`\r\n-  - `MOCK_SERVICES_MODE=false` forced so real agent routing runs\r\n-  - Assertions cover HTTP response shape AND persisted Firestore state\r\n-\"\"\"\r\n-\r\n-# ruff: noqa: PT009\r\n-\r\n-from __future__ import annotations\r\n-\r\n-import json\r\n-import os\r\n-from unittest.mock import patch\r\n-\r\n-os.environ.setdefault(\"TESTING_AUTH_BYPASS\", \"true\")\r\n-os.environ.setdefault(\"GEMINI_API_KEY\", \"test-api-key\")\r\n"]
[0.000, "o", "-\r\n-from mvp_site import main  # noqa: E402\r\n"]
[0.000, "o", "-from mvp_site.tests.fake_firestore import (  # noqa: E402\r\n"]
[0.000, "o", "-    FakeFirestoreClient,\r\n"]
[0.000, "o", "-    FakeLLMResponse,\r\n-)\r\n"]
[0.000, "o", "-from mvp_site.tests.test_end2end import End2EndBaseTestCase  # noqa: E402\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-def _disable_mock_services_mode(test_case: End2EndBaseTestCase) -> None:\r\n-    \"\"\"Force MOCK_SERVICES_MODE=false so real agent routing runs.\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-    Mirrors the pattern in test_modal_integration_end2end.py:264-273.\r\n"]
[0.000, "o", "-    \"\"\"\r\n"]
[0.000, "o", "-    old_mock_services_mode = os.environ.get(\"MOCK_SERVICES_MODE\")\r\n"]
[0.000, "o", "-    os.environ[\"MOCK_SERVICES_MODE\"] = \"false\"\r\n-    test_case.addCleanup(\r\n"]
[0.000, "o", "-        lambda: (\r\n"]
[0.000, "o", "-            os.environ.pop(\"MOCK_SERVICES_MODE\", None)\r\n"]
[0.000, "o", "-            if old_mock_services_mode is None\r\n-            else os.environ.__setitem__(\"MOCK_SERVICES_MODE\", old_mock_services_mode)\r\n"]
[0.000, "o", "-        )\r\n"]
[0.000, "o", "-    )\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-\r\n-class TestLevelUpModalExitEnd2End(End2EndBaseTestCase):\r\n"]
[0.000, "o", "-    \"\"\"End-to-end coverage for the canonical-only level-up exit contract.\"\"\"\r\n"]
[0.000, "o", "-\r\n"]
