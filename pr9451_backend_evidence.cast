[0.000, "o", "-        \"id\": \"level_up_fighting_style_dueling\",\r\n"]
[0.000, "o", "-        \"text\": \"Fighting Style: Dueling\",\r\n-        \"description\": \"When you are wielding a melee weapon in one hand and no other weapons, you gain a +2 bonus to damage rolls with that weapon.\",\r\n-        \"risk_level\": \"safe\",\r\n-        \"freeze_time\": true\r\n-      },\r\n-      {\r\n-        \"id\": \"level_up_spells_recommended\",\r\n-        \"text\": \"Prepare Recommended Spells\",\r\n-        \"description\": \"Prepare Cure Wounds, Divine Favor, and Shield of Faith for your 2 Level 1 spell slots.\",\r\n-        \"risk_level\": \"safe\",\r\n-        \"freeze_time\": true\r\n-      },\r\n"]
[0.000, "o", "-      {\r\n"]
[0.000, "o", "-        \"id\": \"finish_level_up_return_to_game\",\r\n"]
[0.000, "o", "-        \"text\": \"Apply Recommended Options and Return to Game\",\r\n"]
[0.000, "o", "-        \"description\": \"Apply +8 HP, Defense Fighting Style, and recommended spells to commit Level 2 and resume the trials.\",\r\n"]
[0.000, "o", "-        \"risk_level\": \"safe\",\r\n"]
[0.000, "o", "-        \"freeze_time\": true\r\n"]
[0.000, "o", "-      }\r\n"]
[0.000, "o", "-    ]\r\n"]
[0.000, "o", "-  },\r\n"]
[0.000, "o", "-  \"action_resolution\": {\r\n"]
[0.000, "o", "-    \"player_input\": \"I try to leave the level-up modal and continue the adventure\",\r\n"]
[0.000, "o", "-    \"interpreted_as\": \"attempt_to_bypass_synchronization\",\r\n"]
