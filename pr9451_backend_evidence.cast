[0.000, "o", "+\r\n+def test_pcd_crossing_cannot_overwrite_different_open_review_session():\r\n"]
[0.000, "o", "+    \"\"\"An amendable review owns its transaction until the player closes it.\"\"\"\r\n"]
[0.000, "o", "+    existing_session = {\r\n+        \"status\": STATUS_IN_PROGRESS,\r\n"]
[0.000, "o", "+        \"from_level\": 1,\r\n"]
[0.000, "o", "+        \"to_level\": 2,\r\n+        \"current_level\": 2,\r\n+        \"target_level\": 2,\r\n+        \"applied\": {\r\n+            \"level\": 2,\r\n+            \"experience\": {\"current\": 306, \"to_next_level\": 594},\r\n+        },\r\n+        \"review_open\": True,\r\n+        \"modal_open\": False,\r\n+        \"source\": \"model\",\r\n+    }\r\n+    original_state = {\r\n+        \"player_character_data\": {\r\n"]
[0.000, "o", "+            \"level\": 3,\r\n+            \"experience\": {\"current\": 2690, \"to_next_level\": 3810},\r\n+        },\r\n"]
[0.000, "o", "+        \"level_up_session\": copy.deepcopy(existing_session),\r\n"]
[0.000, "o", "+    }\r\n"]
[0.000, "o", "+    authored_sheet = {\r\n+        \"level\": 4,\r\n"]
[0.000, "o", "+        \"experience\": {\"current\": 2790, \"to_next_level\": 6500},\r\n"]
[0.000, "o", "+    }\r\n+    state = copy.deepcopy(original_state)\r\n+    state[\"player_character_data\"] = copy.deepcopy(authored_sheet)\r\n+    structured_fields = {\r\n+        \"state_updates\": {\"player_character_data\": copy.deepcopy(authored_sheet)}\r\n+    }\r\n+\r\n+    rewards_engine.canonicalize_rewards(structured_fields, state, original_state)\r\n+\r\n+    assert state[\"level_up_session\"] == existing_session\r\n+\r\n+\r\n+def test_pcd_only_god_mode_preserves_authorized_resource_values():\r\n+    \"\"\"Reducer normalization must preserve God-mode resource semantics.\"\"\"\r\n+    authored_sheet = {\r\n+        \"level\": 4,\r\n+        \"experience\": {\"current\": 2790, \"to_next_level\": 6500},\r\n+        \"resource_registry\": {\r\n+            \"ki\": {\"current\": -1, \"maximum\": 4, \"is_infinite\": True}\r\n"]
[0.000, "o", "+        },\r\n+    }\r\n+    state = {\"player_character_data\": copy.deepcopy(authored_sheet)}\r\n+    original_state = {\r\n"]
[0.000, "o", "+        \"player_character_data\": {\r\n+            \"level\": 3,\r\n"]
[0.000, "o", "+            \"experience\": {\"current\": 2690, \"to_next_level\": 3810},\r\n+        }\r\n+    }\r\n+    structured_fields = {\r\n"]
[0.000, "o", "+        \"state_updates\": {\"player_character_data\": copy.deepcopy(authored_sheet)}\r\n"]
[0.000, "o", "+    }\r\n+    expected_updates = {\"player_character_data\": copy.deepcopy(authored_sheet)}\r\n"]
[0.000, "o", "+    game_state.canonicalize_state_updates_in_place(\r\n"]
[0.000, "o", "+        expected_updates, agent_mode=constants.MODE_GOD\r\n"]
[0.000, "o", "+    )\r\n+    expected_sheet = expected_updates[\"player_character_data\"]\r\n"]
[0.000, "o", "+\r\n"]
[0.000, "o", "+    rewards_engine.canonicalize_rewards(\r\n"]
[0.000, "o", "+        structured_fields,\r\n"]
[0.000, "o", "+        state,\r\n+        original_state,\r\n+        agent_mode=constants.MODE_GOD,\r\n+    )\r\n"]
[0.000, "o", "+\r\n"]
