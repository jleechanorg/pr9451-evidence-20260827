[0.000, "o", "-    \"custom_campaign_state\": {\r\n"]
[0.000, "o", "-      \"core_memories\": {\r\n"]
[0.000, "o", "-        \"append\": \"The Divine Gauntlet requires a spiritual synchronization (level-up) to Tier 2 parameters before the next phase of training can commence.\"\r\n"]
