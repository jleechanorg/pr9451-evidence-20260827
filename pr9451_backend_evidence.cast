[0.000, "o", "-                        ],\r\n"]
[0.000, "o", "-                    },\r\n"]
[0.000, "o", "-                }\r\n"]
[0.000, "o", "-            )\r\n"]
[0.000, "o", "-        )\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-        response = self.client.post(\r\n"]
[0.000, "o", "-            f\"/api/campaigns/{campaign_id}/interaction\",\r\n"]
[0.000, "o", "-            json={\r\n"]
[0.000, "o", "-                \"input\": \"CHOICE:finish_level_up_return_to_game\",\r\n"]
