[0.001, "o", "diff --git a/mvp_site/tests/test_end2end/fixtures/organic_level_up_replay/stage_04_mechanic_choice.json b/mvp_site/tests/test_end2end/fixtures/organic_level_up_replay/stage_04_mechanic_choice.json\r\ndeleted file mode 100644\r\nindex 525774ce5f..0000000000\r\n"]
[0.000, "o", "--- a/mvp_site/tests/test_end2end/fixtures/organic_level_up_replay/stage_04_mechanic_choice.json\r\n+++ /dev/null\r\n@@ -1,71 +0,0 @@\r\n-{\r\n-  \"session_header\": \"[SESSION_HEADER]\\nTimestamp: 1492 DR, Mirtul 15, 12:06:00\\nLocation: Trial Chamber Alpha\\nStatus: Mira - Lvl 1 (Lvl 2 available) | HP: 12/12 | XP: 306/300 | Gold: 25gp\\nConditions: Normal | Exhaustion: 0 | Inspiration: No\",\r\n-  \"resources\": \"HD: 1/1, Spells: No Spells Yet (Level 2 pending), Lay on Hands: 5/5, Potions: 0, Exhaustion: 0\",\r\n-  \"narrative\": \"The shimmering white light of the Forge of Souls pulses in response to your decision. You feel a surge of structured vitality as the Gauntlet's energy reinforces your physical vessel, preparing to anchor your increased resilience once the synchronization is finalized. \\n\\n\\\"Vitality parameters acknowledged,\\\" the genderless voice echoes. \\\"Proceed to Martial Discipline selection. The Forge identifies two compatible Fighting Styles for your current trajectory.\\\"\\n\\nSpectral images of your own form appear i"]
[0.000, "o", "n the mists—one standing stalwart behind a shield, the other striking with precision and lethal grace. You must choose how you will master the blade before the light of Tier 2 can be fully claimed.\\n\\n**Pending Selections:**\\n- **Vitality**: Fixed HP (+8 HP)\\n- **Fighting Style**: Pending selection\\n- **Spells**: Pending finalization of Cure Wounds, Divine Favor, and Shield of Faith\\n- **Features**: Divine Smite and Spellcasting unlock on finish\",\r\n"]
[0.000, "o", "-  \"level_up_signal\": {\r\n-    \"current_level\": 1,\r\n-    \"target_level\": 2\r\n-  },\r\n-  \"planning_block\": {\r\n-    \"thinking\": \"The player has selected the Fixed HP method. I am now presenting the Fighting Style options (Defense and Dueling) as the primary pending decision. I have also included the option to roll for HP if they wish to change that selection, and the final choice to accept the recommended package and return to the game.\",\r\n-    \"context\": \"Level-up modal: Fighting Style selection for Level 2 Paladin.\",\r\n-    \"choices\": [\r\n-      {\r\n-        \"id\": \"level_up_fighting_style_defense\",\r\n-        \"text\": \"Fighting Style: Defense\",\r\n-        \"description\": \"Choose the Defense style: gain a +1 bonus to AC while wearing armor.\",\r\n-        \"risk_level\": \"safe\",\r\n"]
[0.000, "o", "-        \"freeze_time\": true\r\n-      },\r\n-      {\r\n-        \"id\": \"level_up_fighting_style_dueling\",\r\n"]
[0.000, "o", "-        \"text\": \"Fighting Style: Dueling\",\r\n"]
[0.000, "o", "-        \"description\": \"Choose the Dueling style: +2 bonus to damage rolls with a one-handed melee weapon.\",\r\n-        \"risk_level\": \"safe\",\r\n-        \"freeze_time\": true\r\n-      },\r\n-      {\r\n-        \"id\": \"level_up_hp_roll\",\r\n-        \"text\": \"Change Vitality: Roll for HP\",\r\n-        \"description\": \"Change your selection to roll for HP (1d10 + CON) instead of taking the fixed average.\",\r\n-        \"risk_level\": \"safe\",\r\n-        \"freeze_time\": true\r\n-      },\r\n-      {\r\n-        \"id\": \"finish_level_up_return_to_game\",\r\n-        \"text\": \"Apply Recommended Options and Return to Game\",\r\n-        \"description\": \"Accept the current selections (+8 HP, Defense style, recommended spells), close the modal, and resume the trials.\",\r\n-        \"risk_level\": \"safe\",\r\n-        \"freeze_time\": true\r\n-      }\r\n-    ]\r\n-  },\r\n-  \"state_updates\": {\r\n-    \"custom_campaign_state\": {\r\n-      \"level_up_in_progress\": true,\r\n"]
[0.000, "o", "-      \"level_up_pending\": true,\r\n-      \"level_up_complete\": false,\r\n-      \"level_up_stage\": \"fighting_style_selection\",\r\n-      \"pending_level_up_selections\": {\r\n-        \"hp_method\": \"fixed\",\r\n-        \"hp_gain\": 8\r\n-      },\r\n-      \"core_memories\": {\r\n-        \"append\": \"Mira has selected the structured vitality of the Forge for her Level 2 synchronization, opting for fixed HP growth as she prepares to anchor her new martial discipline.\"\r\n-      }\r\n-    }\r\n-  },\r\n-  \"rewards_box\": {\r\n-    \"source\": \"combat\",\r\n-    \"xp_gained\": 0,\r\n-    \"current_xp\": 306,\r\n-    \"next_level_xp\": 300,\r\n-    \"level_up_available\": true,\r\n-    \"new_level\": 2\r\n-  },\r\n-  \"location_confirmed\": \"Trial Chamber Alpha\",\r\n-  \"entities_mentioned\": [\r\n-    \"Mira\",\r\n-    \"Forge of Souls\"\r\n-  ]\r\n-}\r\n"]
[0.002, "o", "diff --git a/mvp_site/tests/test_end2end/fixtures/organic_level_up_replay/stage_05_finish.json b/mvp_site/tests/test_end2end/fixtures/organic_level_up_replay/stage_05_finish.json\r\ndeleted file mode 100644\r\nindex 20bab2dad7..0000000000\r\n--- a/mvp_site/tests/test_end2end/fixtures/organic_level_up_replay/stage_05_finish.json\r\n+++ /dev/null\r\n@@ -1,93 +0,0 @@\r\n-{\r\n-  \"session_header\": \"[SESSION_HEADER]\\nTimestamp: 1492 DR, Mirtul 15, 12:06:00\\nLocation: Trial Chamber Alpha\\nStatus: Lvl 2 Paladin | HP: 20/20 | XP: 306/900 | Gold: 25gp\\nConditions: None | Exhaustion: 0 | Inspiration: No\",\r\n-  \"resources\": \"HD: 2/2 | Spells: L1 2/2 | Lay on Hands: 10/10 | Exhaustion: 0\",\r\n-  \"narrative\": \"The pillar of shimmering white light pulses one final time, a silent explosion of divine clarity that anchors the Forge's gifts into your very being. You feel your muscles knit with unnatural strength, your heart beating with a steady, celestial rhythm that defies fatigue. The brass filigree of your signet ring glows momentarily bef"]
[0.000, "o", "ore settling into a warm, constant hum. \\n\\nAs the radiance fades, you stand alone in Trial Chamber Alpha. The wreckage of the sparring construct remains silent, but your perception has shifted. You can feel the Weave of the Gauntlet now—a shimmering grid of potential that you can tap into to mend wounds or smite the unrighteous. Your chain mail feels lighter, more like a second skin than a burden, as your defensive training takes root. \\n\\n\\\"Synchronization Complete,\\\" the voice of the Gauntlet announces, the tone slightly more resonant than before. \\\"Candidate Mira, Tier 2 authorization granted. Proceed to Sequence 002: Tactical Synthesis.\\\"\\n\\nThe far doors of the chamber, massive slabs of obsidian etched with gears, begin to grind open. Beyond lies a corridor of brass-lined marble, leading toward a larger arena where the hum of more complex machinery awaits.\",\r\n"]
