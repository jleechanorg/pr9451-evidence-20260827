[0.000, "o", "--- a/mvp_site/tests/test_end2end/fixtures/organic_level_up_replay/stage_02_modal_entry.json\r\n+++ /dev/null\r\n@@ -1,61 +0,0 @@\r\n-{\r\n-  \"session_header\": \"[SESSION_HEADER]\\nTimestamp: 1492 DR, Mirtul 15, 12:06:00\\nLocation: Trial Chamber Alpha\\nStatus: Lvl 1 (Lvl 2 available) Paladin | HP: 12/12 | XP: 306/300 | Gold: 25gp\\nConditions: None | Exhaustion: 0 | Inspiration: No\",\r\n-  \"resources\": \"HD: 1/1, Spells: No Spells Yet (Level 2 pending), Lay on Hands: 5/5, Potions: 0\",\r\n-  \"narrative\": \"The pillar of shimmering white light intensifies, the divine resonance of the Gauntlet vibrating through the very marrow of your bones. As you stand over the cooling brass of the defeated construct, the celestial patterns on the obsidian floor begin to glow in harmony with your signet ring. \\n\\nKnowledge that was once abstract—the mechanics of channeling faith into a physical strike, the specific cadences of protective prayers—suddenly anchors itself in your mind. You feel the weight of your oath pressing against your he"]
[0.000, "o", "art, not as a burden, but as a source of inexhaustible power. The light of the Forge of Souls is no longer just around you; it is beginning to stir within you.\\n\\nRecommended package:\\n- **HP**: +8 (Fixed 6 + 2 CON). New Max HP: 20.\\n- **Fighting Style**: **Defense** (+1 bonus to AC while wearing armor). New AC: 19.\\n- **Spells Prepared**: *Cure Wounds*, *Divine Favor*, *Shield of Faith*.\\n- **Class Features**: Divine Smite, Spellcasting.\",\r\n"]
[0.000, "o", "-  \"planning_block\": {\r\n-    \"thinking\": \"Mira has crossed the threshold to Level 2. This level is a major power spike for Paladins, granting them their Fighting Style, Spellcasting, and the iconic Divine Smite feature. I will recommend the 'Defense' style to capitalize on her high AC as a front-line tank in this gauntlet.\",\r\n-    \"context\": \"Level-up modal active in Trial Chamber Alpha.\",\r\n"]
[0.000, "o", "-    \"choices\": [\r\n-      {\r\n-        \"id\": \"level_up_hp_fixed\",\r\n"]
[0.000, "o", "-        \"text\": \"Increase HP (Fixed)\",\r\n-        \"description\": \"Increase maximum HP by 8 (6 + Constitution modifier). New Max HP: 20.\",\r\n-        \"risk_level\": \"safe\",\r\n-        \"freeze_time\": true\r\n"]
[0.000, "o", "-      },\r\n-      {\r\n-        \"id\": \"level_up_fighting_style_defense\",\r\n"]
[0.000, "o", "-        \"text\": \"Fighting Style: Defense\",\r\n-        \"description\": \"While you are wearing armor, you gain a +1 bonus to AC. (Recommended)\",\r\n"]
[0.000, "o", "-        \"risk_level\": \"safe\",\r\n-        \"freeze_time\": true\r\n-      },\r\n"]
