[0.000, "o", "+\"\"\"Contract tests for the current level-up prompt boundaries.\r\n"]
[0.000, "o", "+\r\n"]
[0.000, "o", "+GOAL: keep the prompt contract aligned with the server-owned level-up flow.\r\n+MODIFICATION: cover only the canonical PCD grant/amend surface and Finish's\r\n"]
[0.000, "o", "+close-only behavior.\r\n"]
[0.000, "o", "+NECESSITY: retired session, reward, signal, and finish-sheet contracts made\r\n"]
[0.000, "o", "+prompt tests require behavior the runtime no longer supports.\r\n"]
[0.000, "o", "+INTEGRATION PROOF: these tests read the exact prompt files assembled for the\r\n"]
[0.000, "o", "+LevelUp agent.\r\n"]
[0.000, "o", " \"\"\"\r\n"]
[0.000, "o", " \r\n"]
[0.000, "o", " from __future__ import annotations\r\n"]
[0.000, "o", " \r\n from pathlib import Path\r\n"]
[0.000, "o", " \r\n"]
[0.000, "o", "-# ---------------------------------------------------------------------------\r\n-# Helpers\r\n-# ---------------------------------------------------------------------------\r\n \r\n PROMPTS_DIR = Path(__file__).parent.parent / \"prompts\"\r\n+LEVEL_UP_PROMPTS = (\r\n+    \"level_up_instruction.md\",\r\n+    \"level_up_modal_override_instruction.md\",\r\n+    \"level_up_conclude_instruction.md\",\r\n+)\r\n \r\n \r\n def _load(filename: str) -> str:\r\n     return (PROMPTS_DIR / filename).read_text(encoding=\"utf-8\")\r\n \r\n \r\n-# ---------------------------------------------------------------------------\r\n-# Tests: finish-turn full-sheet mandate\r\n-# ---------------------------------------------------------------------------\r\n-\r\n-\r\n-def test_conclude_mandates_features_on_finish():\r\n-    \"\"\"The conclude instruction must require writing class features gained at the\r\n"]
[0.000, "o", "-    new level into state_updates on the finish turn — not just level/HP/slots.\"\"\"\r\n-    text = _load(\"level_up_conclude_instruction.md\")\r\n-    # Must mention features (class features gained) as part of the commit cascade\r\n-    has_features = any(\r\n-        kw in text.lower() for kw in [\"features\", \"class features\", \"class_features\"]\r\n-    )\r\n"]
[0.000, "o", "-    assert has_features, (\r\n-        \"level_up_conclude_instruction.md must mandate writing class features \"\r\n-        \"into state_updates on the finish turn (M-A: full-sheet requirement)\"\r\n"]
[0.000, "o", "-    )\r\n-\r\n"]
[0.001, "o", "-\r\n"]
[0.000, "o", "-def test_conclude_mandates_cumulative_features_not_diff():\r\n"]
[0.000, "o", "-    \"\"\"The conclude instruction must mandate the COMPLETE cumulative features list\r\n"]
[0.000, "o", "-    (prior features PLUS newly gained), not a gained-only diff.\r\n-\r\n"]
[0.000, "o", "-    Root cause (I4 / explore-risks PT1): firestore_service._deep_merge REPLACES\r\n"]
[0.000, "o", "-    lists wholesale, so a gained-only ``features`` list silently erases the\r\n-    character's prior features (e.g. Second Wind / Fighting Style). The mandate\r\n"]
[0.000, "o", "-    must therefore tell the model to re-list prior features alongside the new ones.\r\n-    This is enforced at the prompt + test layer only — NOT by an additive merge\r\n"]
[0.000, "o", "-    (PT2) or a backend feature net (PT1).\"\"\"\r\n"]
[0.000, "o", "-    text = _load(\"level_up_conclude_instruction.md\")\r\n"]
[0.000, "o", "-    lower = text.lower()\r\n"]
[0.000, "o", "-    # The mandate must signal the list is complete/cumulative (preserves prior),\r\n"]
[0.000, "o", "-    # not a diff of only the gained features.\r\n"]
[0.000, "o", "-    has_cumulative = any(\r\n"]
[0.000, "o", "-        kw in lower\r\n-        for kw in [\"cumulative\", \"already had\", \"already has\", \"prior features\"]\r\n"]
[0.000, "o", "-    )\r\n"]
[0.000, "o", "-    assert has_cumulative, (\r\n"]
[0.000, "o", "-        \"level_up_conclude_instruction.md must mandate the COMPLETE cumulative \"\r\n"]
[0.000, "o", "-        \"features list (prior features + newly gained), because the sheet REPLACES \"\r\n-        \"the stored features list wholesale. A gained-only diff would erase prior \"\r\n"]
[0.000, "o", "-        \"features (I4 / list-replace merge).\"\r\n"]
[0.000, "o", "-    )\r\n"]
[0.000, "o", "-    # The mandate must explain that the list is replaced wholesale (the WHY), so the\r\n"]
[0.000, "o", "-    # generic instruction survives prompt edits without re-introducing the diff shape.\r\n"]
[0.000, "o", "-    has_replace_rationale = any(\r\n-        kw in lower for kw in [\"replace\", \"overwrite\", \"erase\", \"wholesale\"]\r\n"]
[0.000, "o", "-    )\r\n"]
[0.000, "o", "-    assert has_replace_rationale, (\r\n"]
[0.000, "o", "-        \"level_up_conclude_instruction.md must explain that the features list is \"\r\n"]
[0.000, "o", "-        \"REPLACED wholesale on merge, so the model knows it must re-list prior \"\r\n-        \"features (root-cause-first wording, not a class-specific patch).\"\r\n"]
[0.000, "o", "-    )\r\n"]
[0.000, "o", "-\r\n"]
[0.000, "o", "-\r\n-def test_conclude_mandates_spells_on_finish():\r\n"]
