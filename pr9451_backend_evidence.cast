[0.000, "o", "+def test_pcd_replay_preserves_completed_legacy_signal_session():\r\n"]
[0.000, "o", "+    \"\"\"A completed target_level-only legacy session stays sealed on replay.\"\"\"\r\n+    original_state = {\r\n"]
[0.000, "o", "+        \"player_character_data\": {\r\n+            \"level\": 3,\r\n+            \"experience\": {\"current\": 2690, \"to_next_level\": 3810},\r\n+        }\r\n+    }\r\n+    authored_sheet = {\r\n+        \"level\": 4,\r\n+        \"health\": {\"hp\": 27, \"hp_max\": 27},\r\n+        \"experience\": {\"current\": 2790, \"to_next_level\": 6500},\r\n+    }\r\n+    state = apply_model_level_up_signal(\r\n+        original_state,\r\n+        {\"current_level\": 3, \"target_level\": 4},\r\n+        source_story_id=\"legacy-crossing\",\r\n+    )\r\n+    state[\"player_character_data\"] = copy.deepcopy(authored_sheet)\r\n"]
[0.000, "o", "+    state = close_review(state)\r\n+    completed_session = copy.deepcopy(state[\"level_up_session\"])\r\n"]
[0.000, "o", "+    assert completed_session[\"review_open\"] is False\r\n"]
[0.000, "o", "+    assert completed_session[\"modal_open\"] is False\r\n+    assert completed_session[\"target_level\"] == 4\r\n"]
[0.000, "o", "+    assert \"to_level\" not in completed_session\r\n"]
[0.000, "o", "+    structured_fields = {\r\n"]
[0.000, "o", "+        \"state_updates\": {\"player_character_data\": copy.deepcopy(authored_sheet)}\r\n"]
[0.000, "o", "+    }\r\n+\r\n"]
[0.000, "o", "+    rewards_engine.canonicalize_rewards(structured_fields, state, original_state)\r\n"]
[0.000, "o", "+\r\n"]
[0.000, "o", "+    assert state[\"level_up_session\"] == completed_session\r\n"]
