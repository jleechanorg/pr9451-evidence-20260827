[0.000, "o", "+        self, mock_gemini_request, mock_get_db\r\n+    ):\r\n"]
[0.000, "o", "+        \"\"\"Replay one BQ exchange without turning its response into a spec.\r\n+\r\n"]
[0.000, "o", "+        The request artifact is the source for the contract shape. The actual\r\n+        request assembled by the backend is captured at the provider seam,\r\n"]
[0.000, "o", "+        normalized for volatile values, and compared against that shape. The\r\n+        response is only an observed model output; it is returned through the\r\n"]
[0.000, "o", "+        SDK-shaped fake so parser and route behavior can be exercised without\r\n+        asserting that the observed output is correct.\r\n"]
[0.000, "o", "+        \"\"\"\r\n+        self._enable_real_services()\r\n"]
[0.000, "o", "+        db = FakeFirestoreClient()\r\n+        mock_get_db.return_value = db\r\n+        phase_entry, bq_request, observed_response = _load_bq_level_up_phase(\r\n"]
[0.000, "o", "+            \"l4_review\"\r\n+        )\r\n"]
[0.000, "o", "+        self.assertEqual(\r\n+            set(observed_response),\r\n"]
[0.000, "o", "+            set(phase_entry[\"observed_response_top_level_keys\"]),\r\n+        )\r\n"]
[0.000, "o", "+\r\n+        campaign_id = \"test-bq-level-up-fixture-contract\"\r\n"]
[0.000, "o", "+        self._seed_campaign_doc(db, campaign_id, \"BQ Level-Up Fixture Contract\")\r\n+        fixture_state = copy.deepcopy(bq_request[\"game_state\"])\r\n"]
[0.000, "o", "+        fixture_state[\"user_id\"] = self.TEST_USER_ID\r\n+        self._game_state_ref(db, campaign_id).set(fixture_state)\r\n"]
[0.000, "o", "+\r\n+        expected_shape = _request_contract_shape(bq_request)\r\n+        expected_game_state_tree = _request_contract_tree(\r\n"]
[0.000, "o", "+            bq_request[\"game_state\"]\r\n+        )\r\n"]
[0.000, "o", "+        expected_pcd = bq_request[\"game_state\"][\"player_character_data\"]\r\n+        request_golden = json.loads(\r\n"]
[0.000, "o", "+            (_GOLDEN_FIXTURE_DIR / \"request_golden.json\").read_text(\r\n+                encoding=\"utf-8\"\r\n"]
[0.000, "o", "+            )\r\n+        )\r\n"]
[0.000, "o", "+        level_up_prompt = (\r\n+            Path(__file__).parents[2] / \"prompts\" / \"level_up_instruction.md\"\r\n+        ).read_text(encoding=\"utf-8\")\r\n"]
[0.000, "o", "+        self.assertEqual(\r\n+            hashlib.sha256(level_up_prompt.encode(\"utf-8\")).hexdigest(),\r\n"]
[0.000, "o", "+            request_golden[\"stable_prompt_sha256\"][\"level_up_instruction.md\"],\r\n+        )\r\n"]
[0.000, "o", "+\r\n+        def _replay_observed_response(*_args, **kwargs):\r\n"]
[0.000, "o", "+            actual_request = kwargs[\"gemini_request\"].to_json()\r\n+            self.assertEqual(\r\n"]
[0.000, "o", "+                _request_contract_shape(actual_request),\r\n+                expected_shape,\r\n"]
[0.000, "o", "+            )\r\n+            self.assertEqual(\r\n"]
[0.000, "o", "+                _request_contract_tree(actual_request[\"game_state\"]),\r\n+                expected_game_state_tree,\r\n"]
[0.000, "o", "+            )\r\n+            self.assertEqual(\r\n+                actual_request[\"game_state\"][\"player_character_data\"],\r\n"]
[0.000, "o", "+                expected_pcd,\r\n+            )\r\n"]
[0.000, "o", "+            self.assertIn(level_up_prompt.strip(), kwargs[\"system_instruction_text\"])\r\n+            return RealisticFakeLLMResponse(json_text=json.dumps(observed_response))\r\n"]
[0.000, "o", "+\r\n+        mock_gemini_request.side_effect = _replay_observed_response\r\n"]
[0.000, "o", "+        user_action = bq_request[\"user_action\"].split(\r\n+            \"\\n\\n[SYSTEM ENFORCEMENT\", 1\r\n"]
[0.000, "o", "+        )[0]\r\n+        response = self._post_interaction(campaign_id, user_action)\r\n"]
[0.000, "o", "+        self.assertEqual(response.status_code, 200, response.get_data(as_text=True))\r\n+        self.assertEqual(mock_gemini_request.call_count, 1)\r\n"]
