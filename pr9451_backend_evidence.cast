[0.000, "o", "ic\")\r\n \r\n@@ -532,7 +532,7 @@ def apply_review_reopen(\r\n     current_session = current_game_state_dict.get(\"level_up_session\")\r\n     if (\r\n         not isinstance(current_session, dict)\r\n-        or current_session.get(\"status\") != STATUS_IN_PROGRESS\r\n+        or current_session.get(\"review_open\") is not True\r\n         or current_session.get(\"modal_open\") is True\r\n     ):\r\n         return False\r\n@@ -544,7 +544,7 @@ def apply_review_reopen(\r\n     reopened_session = reopened.get(\"level_up_session\")\r\n     if (\r\n         not isinstance(reopened_session, dict)\r\n-        or reopened_session.get(\"status\") != STATUS_IN_PROGRESS\r\n+        or reopened_session.get(\"review_open\") is not True\r\n         or reopened_session.get(\"modal_open\") is not True\r\n     ):\r\n         return False\r\n@@ -620,16 +620,16 @@ def _reapply_amended_level_up_selections(\r\n     current_game_state_dict: dict[str, Any],\r\n     state_changes: dict[str, Any],\r\n ) -> bool:\r\n-    \"\"\"Validate and stage amended selections on an open review.\r\n"]
[0.000, "o", "+    \"\"\"Commit an authored review amendment through the canonical reducer.\r\n"]
[0.000, "o", " \r\n-    Returns True iff the amendment was successfully staged this turn\r\n+    Returns True iff the amendment was successfully committed this turn\r\n     (mirrors ``apply_committed_grant``'s return-bool pattern). The review\r\n     stays OPEN after a successful amend; only ``close_review()`` seals it\r\n     (driven exclusively by the player picking\r\n     ``finish_level_up_return_to_game``). The player may amend again on a\r\n-    later turn, or finish at any time. Staging updates only the session's\r\n-    ``selections`` while preserving the committed ``applied`` sheet, so\r\n-    player-character mechanics do not change before the explicit commit.\r\n+    later turn, or finish at any time. A sheet amendment is committed through\r\n+    ``apply_level_up(operation=\"amend\")`` immediately; Finish never applies\r\n+    mechanics.\r\n"]
[0.000, "o", " \r\n     Guard, not dead code: ``is_review_open()`` is True from the grant turn\r\n     onward (the grant leaves ``review_open=True``, not False), so this guard\r\n@@ -649,49 +649,53 @@ def _reapply_amended_level_up_selections(\r\n"]
[0.000, "o", "     ``grant_legacy_flags(_staged_state)`` the same way\r\n     the staged session is written -- merged into the existing dict (not\r\n     replaced) so\r\n-    ``pending_level_up_selections`` and any other keys already staged there\r\n"]
