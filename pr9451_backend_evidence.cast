[0.000, "o", "+def test_apply_level_up_rejects_progression_padded_with_identity():\r\n"]
[0.000, "o", "+    \"\"\"Stable identity is not target-level mechanics.\"\"\"\r\n"]
[0.000, "o", "+    state = {\"player_character_data\": {\"level\": 2}}\r\n"]
[0.000, "o", "+\r\n"]
[0.000, "o", "+    with pytest.raises(ValueError, match=\"target-level mechanics\"):\r\n"]
[0.000, "o", "+        apply_level_up(\r\n"]
[0.000, "o", "+            state,\r\n"]
[0.000, "o", "+            level_facts={\r\n+                \"to_level\": 3,\r\n"]
[0.000, "o", "+                \"sheet\": {\r\n"]
[0.000, "o", "+                    \"level\": 3,\r\n"]
[0.000, "o", "+                    \"experience\": {\"current\": 900},\r\n"]
[0.000, "o", "+                    \"name\": \"Ser Arion\",\r\n"]
[0.000, "o", "+                },\r\n"]
[0.000, "o", "+            },\r\n"]
[0.000, "o", "+            source=SOURCE_MODEL,\r\n"]
[0.000, "o", "+        )\r\n"]
[0.000, "o", "+\r\n"]
[0.000, "o", "+\r\n+def test_apply_level_up_rejects_unchanged_hp_max():\r\n"]
[0.000, "o", "+    \"\"\"Repeating stable HP does not prove target-level mechanics were applied.\"\"\"\r\n+    state = {\"player_character_data\": {\"level\": 2, \"hp\": {\"max\": 18}}}\r\n"]
[0.000, "o", "+\r\n"]
[0.000, "o", "+    with pytest.raises(ValueError, match=\"target-level mechanics\"):\r\n"]
[0.000, "o", "+        apply_level_up(\r\n"]
[0.000, "o", "+            state,\r\n"]
[0.000, "o", "+            level_facts={\r\n+                \"to_level\": 3,\r\n+                \"sheet\": {\r\n"]
[0.000, "o", "+                    \"level\": 3,\r\n"]
[0.000, "o", "+                    \"experience\": {\"current\": 900},\r\n"]
[0.000, "o", "+                    \"hp\": {\"max\": 18},\r\n"]
[0.000, "o", "+                },\r\n"]
[0.000, "o", "+            },\r\n+            source=SOURCE_MODEL,\r\n"]
[0.000, "o", "+        )\r\n"]
