[0.831, "o", "diff --git a/mvp_site/structured_fields_utils.py b/mvp_site/structured_fields_utils.py\r\nindex f5754bcab2..6c9a8948d2 100644\r\n--- a/mvp_site/structured_fields_utils.py\r\n+++ b/mvp_site/structured_fields_utils.py\r\n@@ -13,6 +13,53 @@ from mvp_site.action_resolution_utils import (\r\n \r\n T = TypeVar(\"T\")\r\n _UNSET_MARKER = object()\r\n+_MODEL_PROGRESSION_REWARD_KEYS = frozenset(\r\n+    {\r\n+        \"current_level\",\r\n+        \"current_xp\",\r\n+        \"level_up_available\",\r\n+        \"level_up_from_level\",\r\n+        \"level_up_to_level\",\r\n+        \"new_level\",\r\n+        \"next_level_xp\",\r\n+        \"progress_percent\",\r\n+        \"resolved_target_level\",\r\n+        \"target_level\",\r\n+        \"xp\",\r\n+        \"xpAmount\",\r\n+        \"xp_awarded\",\r\n+        \"xp_earned\",\r\n+        \"xp_gained\",\r\n+        \"xp_needed\",\r\n"]
[0.000, "o", "+        \"xp_to_next_level\",\r\n+        \"xp_total\",\r\n+    }\r\n+)\r\n+\r\n+\r\n+def strip_model_progression_fields(structured_fields: Any) -> Any:\r\n+    \"\"\"Make legacy model progression fields inert while retaining loot/currency.\"\"\"\r\n+    if not isinstance(structured_fields, dict):\r\n+        return structured_fields\r\n+    structured_fields.pop(constants.FIELD_LEVEL_UP_SIGNAL, None)\r\n+    rewards_box = structured_fields.get(constants.FIELD_REWARDS_BOX)\r\n+    if isinstance(rewards_box, dict):\r\n+        structured_fields[constants.FIELD_REWARDS_BOX] = {\r\n+            key: value\r\n+            for key, value in rewards_box.items()\r\n+            if key not in _MODEL_PROGRESSION_REWARD_KEYS\r\n+        }\r\n+    state_updates = structured_fields.get(constants.FIELD_STATE_UPDATES)\r\n+    if isinstance(state_updates, dict):\r\n+        nested_rewards_box = state_updates.get(constants.FIELD_REWARDS_BOX)\r\n+        if isinstance(nested_rewards_box, dict):\r\n+            state_updates[constants.FIELD_REWARDS_BOX] = {\r\n"]
[0.000, "o", "+                key: value\r\n"]
