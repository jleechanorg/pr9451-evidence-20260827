[0.000, "o", "+def test_review_open_controls_amendability_independent_of_status():\r\n"]
[0.000, "o", "+    state = {\r\n"]
[0.000, "o", "+        \"player_character_data\": {\r\n"]
[0.000, "o", "+            \"level\": 3,\r\n"]
[0.000, "o", "+            \"experience\": {\"current\": 900},\r\n"]
[0.000, "o", "+            \"hp\": {\"max\": 20},\r\n"]
[0.000, "o", "+        },\r\n"]
[0.000, "o", "+        \"level_up_session\": {\r\n"]
[0.000, "o", "+            \"status\": STATUS_COMPLETE,\r\n+            \"from_level\": 2,\r\n"]
[0.000, "o", "+            \"to_level\": 3,\r\n+            \"target_level\": 3,\r\n"]
[0.000, "o", "+            \"review_open\": True,\r\n"]
[0.000, "o", "+            \"applied\": {\"level\": 3, \"hp\": {\"max\": 20}},\r\n"]
[0.000, "o", "+        },\r\n"]
[0.000, "o", "+    }\r\n"]
[0.000, "o", "+\r\n"]
[0.000, "o", "+    assert is_amendable_review_live(state) is True\r\n"]
[0.000, "o", "+    amended, _warnings = apply_level_up(\r\n"]
[0.000, "o", "+        state,\r\n"]
[0.000, "o", "+        level_facts={\r\n"]
[0.000, "o", "+            \"to_level\": 3,\r\n"]
[0.000, "o", "+            \"sheet\": {\"level\": 3, \"experience\": {\"current\": 900}, \"hp\": {\"max\": 22}},\r\n"]
[0.000, "o", "+        },\r\n"]
[0.000, "o", "+        source=SOURCE_MODEL,\r\n"]
[0.000, "o", "+        operation=\"amend\",\r\n"]
[0.000, "o", "+    )\r\n"]
[0.000, "o", "+    assert amended[\"player_character_data\"][\"hp\"][\"max\"] == 22\r\n"]
[0.000, "o", "+\r\n"]
[0.000, "o", "+\r\n"]
[0.000, "o", "+def test_close_review_closes_lifecycle_and_modal_projection():\r\n"]
[0.000, "o", "+    state = {\r\n"]
[0.000, "o", "+        \"player_character_data\": {\"level\": 3},\r\n"]
[0.000, "o", "+        \"level_up_session\": {\r\n"]
[0.000, "o", "+            \"status\": STATUS_COMPLETE,\r\n+            \"current_level\": 2,\r\n"]
[0.000, "o", "+            \"target_level\": 3,\r\n"]
[0.000, "o", "+            \"modal_open\": True,\r\n"]
[0.000, "o", "+            \"review_open\": True,\r\n"]
[0.000, "o", "+        },\r\n"]
[0.000, "o", "+    }\r\n+\r\n"]
[0.000, "o", "+    result = close_review(state)\r\n"]
[0.000, "o", "+\r\n"]
[0.000, "o", "+    assert result[\"level_up_session\"] == {\r\n"]
[0.000, "o", "+        \"status\": STATUS_COMPLETE,\r\n"]
[0.000, "o", "+        \"current_level\": 2,\r\n"]
[0.000, "o", "+        \"target_level\": 3,\r\n+        \"modal_open\": False,\r\n"]
[0.000, "o", "+        \"review_open\": False,\r\n+    }\r\n+\r\n+\r\n+def test_open_review_ignores_legacy_status_for_applied_review():\r\n+    state = {\r\n+        \"player_character_data\": {\"level\": 3},\r\n+        \"level_up_session\": {\r\n+            \"status\": STATUS_COMPLETE,\r\n"]
[0.000, "o", "+            \"from_level\": 2,\r\n+            \"to_level\": 3,\r\n"]
[0.000, "o", "+            \"target_level\": 3,\r\n"]
[0.000, "o", "+            \"review_open\": False,\r\n"]
[0.000, "o", "+            \"modal_open\": False,\r\n+            \"applied\": {\"level\": 3, \"hp\": {\"max\": 20}},\r\n+        },\r\n"]
[0.000, "o", "+    }\r\n"]
[0.000, "o", "+\r\n"]
[0.000, "o", "+    result = open_review(state)\r\n"]
[0.000, "o", "+\r\n+    assert result[\"level_up_session\"][\"review_open\"] is True\r\n+    assert result[\"level_up_session\"][\"modal_open\"] is True\r\n"]
[0.000, "o", "+\r\n"]
